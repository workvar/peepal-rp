{
  "name": "collegeerp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:schema": "node scripts/gen-db-schema.mjs",
    "gen:graphql": "graphql-codegen --config codegen.ts",
    "gen:graphql:check": "graphql-codegen --config codegen.ts && git diff --exit-code types/graphql.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node tests/dashboard/runner.js",
    "test:headed": "cross-env PW_HEADED=1 node tests/dashboard/runner.js",
    "test:ui": "playwright test --ui --config tests/playwright.config.ts",
    "test:report": "playwright show-report tests/.playwright-report",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@reduxjs/toolkit": "^2.3.0",
    "axios": "^1.7.7",
    "date-fns": "^3.6.0",
    "graphql": "^16.13.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lenis": "^1.1.13",
    "lucide-react": "^0.439.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-redux": "^9.1.2",
    "remark-gfm": "^4.0.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "open": "^10.1.0",
    "typescript": "^5",
    "ws": "^8.18.0"
  }
}
