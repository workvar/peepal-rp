# Copy this file to tests/.env and fill in real values.
# All variables are optional, defaults assume local dev.

# Where the Next.js app is running.
TEST_BASE_URL=http://localhost:3000

# Where the Go (Fiber) backend is running. Tests assume this is reachable.
TEST_API_URL=http://localhost:3001

# Live dashboard server port. Auto-opens at http://localhost:<port>.
DASHBOARD_PORT=9323

# Tenant / org credentials seeded in your backend.
TEST_ORG_SLUG=demo
TEST_ADMIN_EMAIL=admin@college.edu
TEST_ADMIN_PASSWORD=Admin@123

TEST_TEACHER_EMAIL=teacher@college.edu
TEST_TEACHER_PASSWORD=Teacher@123

TEST_STUDENT_EMAIL=student@college.edu
TEST_STUDENT_PASSWORD=Student@123

# Super admin (platform console) creds.
TEST_SUPER_EMAIL=super@peepal.com
TEST_SUPER_PASSWORD=Super@123
