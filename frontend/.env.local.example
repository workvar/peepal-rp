NEXT_PUBLIC_API_URL=http://localhost:8080

# Google Analytics 4 measurement ID. Leave blank for local dev — the
# analytics layer no-ops when this is unset and prints fired events to
# the browser console so you can verify wiring without a real property.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity project ID. Defaults to the project's ID in code, so
# this only needs setting to point a different environment at a separate
# Clarity property. Leave blank to use the built-in default.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
