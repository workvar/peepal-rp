"""
Directs the executor to defer this fragment when the `if` argument is true or undefined.
"""
directive @defer(
  """Deferred when true or undefined."""
  if: Boolean = true
  """Unique name"""
  label: String
) on FRAGMENT_SPREAD | INLINE_FRAGMENT

"""An academic year (e.g. 2024–2025)."""
type AcademicYear {
  """Unique identifier."""
  id: ID!
  """Display name (e.g. 2024-25)."""
  name: String!
  """Start date (YYYY-MM-DD)."""
  startDate: String!
  """End date (YYYY-MM-DD)."""
  endDate: String!
  """Whether this is the currently active academic year."""
  isCurrent: Boolean!
}

input AllocateHostelRoomInput {
  studentId: String!
  roomId: String!
  allocDate: String!
  bedNumber: Int
}

input AllocateTransportInput {
  """Provide exactly one of studentId or employeeId."""
  studentId: String
  """Provide exactly one of studentId or employeeId (staff member)."""
  employeeId: String
  vehicleId: String!
  pickupStop: String
  startDate: String!
}

"""An announcement broadcast to selected roles."""
type AnnouncementItem {
  """Unique identifier."""
  id: ID!
  """Announcement title."""
  title: String!
  """Full announcement body (supports markdown)."""
  body: String!
  """UUID of the author."""
  authorId: String!
  """Comma-separated list of target roles (e.g. student,teacher)."""
  targetRoles: String!
  """Priority: low | normal | high | urgent."""
  priority: String!
  """Whether the announcement is currently published."""
  isPublished: Boolean!
  """Expiry datetime after which the announcement is hidden."""
  expiresAt: String
  """Author user object."""
  author: User
}

"""Input for submitting a leave application."""
input ApplyLeaveInput {
  """Leave type name."""
  leaveType: String!
  """Leave type UUID (preferred over name when available)."""
  leaveTypeId: String
  """Start date (YYYY-MM-DD)."""
  fromDate: String!
  """End date (YYYY-MM-DD)."""
  toDate: String!
  """Reason for the leave."""
  reason: String!
}

"""An approval request raised by a user."""
type ApprovalRequest {
  id: ID!
  flowId: String!
  process: String!
  referenceId: String!
  requesterId: String!
  title: String!
  currentStep: Int!
  status: String!
  createdAt: String!
}

input AssignSalaryTemplateInput {
  employeeId: String!
  templateId: String!
  extraAllowance: Float
  extraDeduction: Float
  effectiveFrom: String
  notes: String
}

"""
A single attendance record for a student or employee on a specific date.
"""
type AttendanceRecord {
  """Unique identifier."""
  id: ID!
  """UUID of the student or employee."""
  entityId: String!
  """Entity type: student | employee."""
  entityType: String!
  """Date of attendance (YYYY-MM-DD)."""
  date: String!
  """Attendance status: present | absent | late."""
  status: String!
  """UUID of the staff who marked attendance."""
  markedBy: String
  """Optional remarks."""
  remarks: String
  """Subject UUID (applicable for student subject-level attendance)."""
  subjectId: String
}

"""Attendance report for a date range."""
type AttendanceReportResult {
  """Report start date."""
  fromDate: String!
  """Report end date."""
  toDate: String!
  """Entity type covered: student | employee."""
  entityType: String!
  """Daily breakdown rows."""
  daily: [DailyAttendanceRow!]!
}

"""Per-tenant attendance configuration."""
type AttendanceSettings {
  id: ID!
  minAttendancePct: Float!
  gracePeriodMinutes: Int!
  lockAfterHours: Int!
}

"""Aggregated attendance statistics for a single student or employee."""
type AttendanceSummaryRow {
  """UUID of the student or employee."""
  entityId: String!
  """Total days recorded."""
  total: Int!
  """Days present."""
  present: Int!
  """Days absent."""
  absent: Int!
  """Days late."""
  late: Int!
  """Attendance percentage (present / total × 100)."""
  attendancePct: Float!
}

"""Result of a bulk salary assignment."""
type BulkAssignResult {
  assignedCount: Int!
}

input BulkAssignSalaryTemplateInput {
  templateId: String!
  employeeIds: [String!]!
  extraAllowance: Float
  extraDeduction: Float
  effectiveFrom: String
  notes: String
}

"""Input for bulk-replacing a timetable for a course/semester."""
input BulkCreateTimetableSlotsInput {
  """Course UUID."""
  courseId: String!
  """Academic year UUID."""
  academicYearId: String
  """Semester number."""
  semester: Int!
  """Section label."""
  section: String
  """Slots to create (replaces existing slots for this course/semester)."""
  slots: [CreateTimetableSlotInput!]!
}

"""A single day in the calendar month view."""
type CalendarDay {
  date: String!
  weekday: Int!
  type: String!
  name: String!
  autoGen: Boolean!
}

"""Full calendar month response."""
type CalendarMonth {
  year: Int!
  month: Int!
  days: [CalendarDay!]!
  working: Int!
  totalDays: Int!
}

"""Calendar generation rules for a tenant."""
type CalendarSettings {
  id: ID!
  sundayOff: Boolean!
  saturdayRule: String!
  saturdayWeeks: String!
  defaultWorking: Int!
}

"""Result of a bulk-copy operation."""
type CopyResult {
  copied: Int!
}

"""A course or programme offered by the institution (e.g. B.Tech CSE)."""
type Course {
  """Unique identifier."""
  id: ID!
  """Full course name."""
  name: String!
  """Short course code (e.g. BTCSE)."""
  code: String!
  """Optional description."""
  description: String
  """Duration in years."""
  durationYears: Int
  """Total number of semesters."""
  totalSemesters: Int
  """Department UUID."""
  departmentId: String
  """Department details."""
  department: Department
  """Batches/cohorts under this course."""
  batches: [CourseBatch!]!
}

"""A batch/cohort under a course (e.g. 2024-2028)."""
type CourseBatch {
  id: ID!
  courseId: String!
  name: String!
  startYear: Int!
  endYear: Int!
}

input CreateAcademicYearInput {
  name: String!
  startDate: String!
  endDate: String!
  isCurrent: Boolean
}

"""Input for creating an announcement."""
input CreateAnnouncementInput {
  """Announcement title."""
  title: String!
  """Body text (markdown supported)."""
  body: String!
  """Comma-separated target roles. Defaults to all roles."""
  targetRoles: String
  """Priority: low | normal | high | urgent. Defaults to normal."""
  priority: String
  """Publish immediately. Defaults to false."""
  isPublished: Boolean
  """Expiry datetime (ISO 8601)."""
  expiresAt: String
}

"""Input for creating a course/programme."""
input CreateCourseInput {
  """Course name."""
  name: String!
  """Course code."""
  code: String!
  """Optional description."""
  description: String
  """Duration in years."""
  durationYears: Int
  """Total semesters."""
  totalSemesters: Int
  """Department UUID."""
  departmentId: String
}

input CreateCustomRoleInput {
  name: String!
  permissions: String
}

"""Input for creating a department."""
input CreateDepartmentInput {
  """Department name."""
  name: String!
  """Employee UUID to designate as Head of Department."""
  headEmployeeId: ID
}

"""Input for creating a new employee profile."""
input CreateEmployeeInput {
  """Full name for the employee's login account."""
  name: String!
  """Login email. Optional only when the organisation signs staff in by
  Employee ID; required otherwise. Unique within the tenant when set."""
  email: String
  """Initial password (hashed on the server). Optional — omit it and set
  sendInvite to e-mail the user a link to choose their own password."""
  password: String
  """When true, e-mail the user a password-setup invite. Honoured only when the
  tenant is allowed and able to send mail, and the user has an email."""
  sendInvite: Boolean
  """Base role for the account: teacher | staff. Defaults to staff."""
  role: String
  """Internal employee ID / badge number."""
  employeeId: String!
  """Department UUID."""
  departmentId: ID
  """Job title."""
  designation: String
  """Contact phone."""
  phone: String
  """Join date (YYYY-MM-DD)."""
  joinDate: String
  """Date of birth (YYYY-MM-DD)."""
  dateOfBirth: String
  """Gender: Male | Female | Other."""
  gender: String
  """Blood group."""
  bloodGroup: String
  """Profile photo URL."""
  photoUrl: String
  """Street address."""
  address: String
  """City."""
  city: String
  """State."""
  state: String
  """PIN code."""
  pincode: String
  """Nationality."""
  nationality: String
  """Personal email."""
  personalEmail: String
  """Emergency contact name."""
  emergencyName: String
  """Emergency contact phone."""
  emergencyPhone: String
  """Employment type: full_time | part_time | contract | visiting."""
  employmentType: String
  """Probation end date (YYYY-MM-DD)."""
  probationEndDate: String
  """Grade/level."""
  gradeLevel: String
  """Banking and PF details."""
  paymentDetails: PaymentDetailsInput
}

"""Input for creating a calendar event."""
input CreateEventInput {
  """Event title."""
  title: String!
  """Description."""
  description: String
  """Start date (YYYY-MM-DD)."""
  eventDate: String!
  """End date (YYYY-MM-DD). Defaults to eventDate if omitted."""
