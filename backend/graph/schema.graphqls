  """Calendar/academic year."""
  year: Int!
  """Total days allocated for this year."""
  total: Float!
  """Days already used."""
  used: Float!
  """Days pending approval."""
  pending: Float!
  """Associated leave type configuration."""
  leaveType: LeaveTypeConfig
}

"""Leave applications grouped by department."""
type LeaveDeptRow {
  """Department name."""
  department: String!
  """Number of leave applications from this department."""
  count: Int!
}

"""Leave count for a calendar month."""
type LeaveMonthRow {
  """Month label (e.g. January)."""
  month: String!
  """Number of leave applications in this month."""
  count: Int!
}

"""A leave application submitted by a user."""
type LeaveRecord {
  """Unique identifier."""
  id: ID!
  """UUID of the user who applied."""
  applicantId: String!
  """Display name of the leave type."""
  leaveTypeName: String!
  """Leave type UUID."""
  leaveTypeId: String
  """Leave start date (YYYY-MM-DD)."""
  fromDate: String!
  """Leave end date (YYYY-MM-DD)."""
  toDate: String!
  """Reason provided by the applicant."""
  reason: String!
  """Status: pending | approved | rejected."""
  status: String!
  """UUID of the admin who reviewed the application."""
  reviewedBy: String
  """Review comments from the admin."""
  reviewNote: String
  """Applicant user object."""
  applicant: User
}

"""
Leave report with status breakdown, monthly trend, and department breakdown.
"""
type LeaveReportResult {
  """Year covered by the report."""
  year: String!
  """Total leave applications in the year."""
  total: Int!
  """Total approved applications."""
  approved: Int!
  """Breakdown by application status."""
  statusBreakdown: [LeaveStatusRow!]!
  """Month-by-month application trend."""
  monthlyTrend: [LeaveMonthRow!]!
  """Applications grouped by department."""
  byDepartment: [LeaveDeptRow!]!
}

"""Leave count breakdown by status."""
type LeaveStatusRow {
  """Status: pending | approved | rejected."""
  status: String!
  """Count of applications with this status."""
  count: Int!
}

"""
A leave type available to employees/staff (e.g. Casual Leave, Sick Leave).
"""
type LeaveTypeConfig {
  """Unique identifier."""
  id: ID!
  """Leave type name."""
  name: String!
  """Short code (e.g. CL, SL, EL)."""
  code: String!
  """Number of days allowed per year."""
  daysPerYear: Int!
  """Whether unused days carry forward to the next year."""
  carryForward: Boolean!
  """Maximum days that can be carried forward."""
  maxCarryForward: Int!
  """Who this leave type applies to: all | employee | student."""
  applicableTo: String!
  """Whether this leave type is currently active."""
  isActive: Boolean!
}

"""A book in the library catalogue."""
type LibraryBook {
  id: ID!
  title: String!
  author: String!
  isbn: String!
  publisher: String!
  publishYear: Int!
  category: String!
  totalCopies: Int!
  availableCopies: Int!
  rack: String!
  shelf: String!
}

"""A book issue record."""
type LibraryIssue {
  id: ID!
  bookId: String!
  book: LibraryBook
  userId: String!
  user: User
  issueDate: String!
  dueDate: String!
  returnDate: String
  status: String!
  fineAmount: Float!
}

"""Per-tenant grading configuration: how subject marks become semester and cumulative results."""
type GradingScheme {
  id: ID!
  """Primary metric reported: cgpa | gpa | percentage | letter | pass_fail."""
  mode: String!
  """Top grade point on the scale (e.g. 10 or 4)."""
  gpaMax: Float!
  """Minimum subject percentage required to pass."""
  passThreshold: Float!
  """Decimal places used when rounding SGPA / CGPA / percentage."""
  decimals: Int!
  """Average grade points weighted by each subject's credits."""
  creditWeighted: Boolean!
  """Combine a subject's assessments using matched exam-type weightages."""
  weightedByExamType: Boolean!
  """Grade scale rows, ascending by sortOrder."""
  bands: [GradeBand!]!
}

"""One row of the grade scale: a percentage range mapped to a letter and grade point."""
type GradeBand {
  id: ID!
  letter: String!
  minPercent: Float!
  maxPercent: Float!
  gradePoint: Float!
  isPass: Boolean!
  sortOrder: Int!
}

"""One grade band to save (bands are replaced wholesale on each save)."""
input GradeBandInput {
  letter: String!
  minPercent: Float!
  maxPercent: Float!
  gradePoint: Float!
  isPass: Boolean!
  sortOrder: Int!
}

"""Full grading configuration to persist for the tenant."""
input SaveGradingSchemeInput {
  mode: String!
  gpaMax: Float!
  passThreshold: Float!
  decimals: Int!
  creditWeighted: Boolean!
  weightedByExamType: Boolean!
  bands: [GradeBandInput!]!
}

"""A single subject's computed result within a semester."""
type SubjectResult {
  subjectId: String
  subject: String!
  credits: Int!
  marksObtained: Float!
  maxMarks: Float!
  percentage: Float!
  letter: String!
  gradePoint: Float!
  isPass: Boolean!
}

"""A semester's computed result: its subjects plus SGPA / percentage / pass."""
type SemesterResult {
  semester: Int!
  subjects: [SubjectResult!]!
  totalCredits: Int!
  marksObtained: Float!
  maxMarks: Float!
  percentage: Float!
  sgpa: Float!
  letter: String!
  isPass: Boolean!
}

"""A student's full academic result: every semester plus the cumulative roll-up."""
type AcademicResult {
  studentId: String!
  studentName: String!
  rollNumber: String!
  courseName: String!
  """Scheme mode in effect (drives client display)."""
  mode: String!
  gpaMax: Float!
  semesters: [SemesterResult!]!
  totalCredits: Int!
  marksObtained: Float!
  maxMarks: Float!
  percentage: Float!
  cgpa: Float!
  letter: String!
  isPass: Boolean!
  """RFC3339 timestamp the result was computed."""
  generatedAt: String!
}

"""A mark entry for a student in a specific exam/subject."""
type Mark {
  """Unique identifier."""
  id: ID!
  """Student UUID."""
  studentId: String!
  """Subject name (denormalized for display)."""
  subject: String!
  """Exam type: internal | external | practical."""
  examType: String!
  """Semester number."""
  semester: Int!
  """Marks scored by the student."""
  marksObtained: Float!
  """Maximum marks for the exam."""
  maxMarks: Float!
  """Computed grade (e.g. A, B+, F)."""
  grade: String
  """UUID of the staff who entered this mark."""
  enteredBy: String
  """Subject UUID."""
  subjectId: String
  """Assessment type (maps to exam schedule type)."""
  assessmentType: String
  """Result status: pass | fail."""
  status: String
  """Academic year UUID."""
  academicYearId: String
  """Whether this mark has been published to the student."""
  isPublished: Boolean!
  """Timestamp when the mark was published."""
  publishedAt: String
  """Associated student object."""
  student: Student
}

"""Input for marking attendance for a single entity."""
input MarkAttendanceInput {
  """UUID of the student or employee."""
  entityId: String!
  """Entity type: student | employee."""
  entityType: String!
  """Date (YYYY-MM-DD)."""
  date: String!
  """Status: present | absent | late."""
  status: String!
  """Optional remarks."""
  remarks: String
  """Subject UUID (for subject-level student attendance)."""
  subjectId: String
}

"""Marks report with grade distribution and subject averages."""
type MarksReportResult {
  """Grade distribution across all students."""
  gradeDistribution: [GradeRow!]!
  """Per-subject averages and pass/fail counts."""
  subjectAverages: [SubjectAvgRow!]!
}

"""Pre-signed upload URL for a unit's video."""
type ModuleVideoUpload {
  """Unit the upload belongs to."""
  unitId: ID!
  """Pre-signed PUT URL — browser uploads directly."""
  uploadUrl: String!
  """Server storage path that will be recorded on the unit after upload."""
  videoStoragePath: String!
}

"""Root mutation type — all write operations."""
type Mutation {
  """_placeholder: reserved for schema validity. Do not use."""
  _placeholder: Boolean
  """Create a supplier."""
  createVendor(input: CreateVendorInput!): Vendor!
  """Update a supplier."""
  updateVendor(id: ID!, input: UpdateVendorInput!): Vendor!
  """Delete a supplier (blocked if purchase orders/invoices reference it)."""
  deleteVendor(id: ID!): Boolean!
  """Create a purchase order (draft) with its line items."""
  createPurchaseOrder(input: CreatePurchaseOrderInput!): PurchaseOrder!
  """Update a purchase order header/lines while still editable."""
  updatePurchaseOrder(id: ID!, input: UpdatePurchaseOrderInput!): PurchaseOrder!
  """Set a purchase order's status (draft/ordered/cancelled)."""
  setPurchaseOrderStatus(id: ID!, status: String!): PurchaseOrder!
  """Delete a purchase order and its lines (blocked once any stock has been received)."""
  deletePurchaseOrder(id: ID!): Boolean!
  """Receive stock against a PO: writes the inventory ledger, drug batches, and recomputes PO status."""
  receivePurchaseOrder(id: ID!, input: ReceivePurchaseOrderInput!): PurchaseOrder!
  """Record a supplier invoice, optionally against a PO."""
  createPurchaseInvoice(input: CreatePurchaseInvoiceInput!): PurchaseInvoice!
  """Record a payment against a supplier invoice."""
  recordPurchasePayment(input: RecordPurchasePaymentInput!): PurchaseInvoice!
  """Delete a supplier invoice."""
  deletePurchaseInvoice(id: ID!): Boolean!
  """Create a new employee profile linked to an existing user account."""
  createEmployee(input: CreateEmployeeInput!): Employee!
  """
  Update an existing employee's profile and (optionally) banking/PF details.
  """
  updateEmployee(id: ID!, input: UpdateEmployeeInput!): Employee!
  """Permanently delete an employee record by ID."""
  deleteEmployee(id: ID!): Boolean!
  """Create a new department."""
  createDepartment(input: CreateDepartmentInput!): Department!
  """Create a new user account."""
  createUser(input: CreateUserInput!): User!
  """Update name/email/role and (optionally) reset the password of a user."""
  updateUser(id: ID!, input: UpdateUserInput!): User!
  """Deactivate a user account (soft-disable — does not delete)."""
  deactivateUser(id: ID!): Boolean!
  """Permanently delete a user account and all associated records."""
  deleteUser(id: ID!): Boolean!
  """Issue (or re-issue) a password-setup invite for a user and e-mail it.
  Returns the link so it can be copied when no SMTP transport is configured."""
  resendInvite(userId: ID!): InviteResult!
  """Update the calling tenant's own email (SMTP) settings."""
  updateEmailSettings(input: UpdateEmailSettingsInput!): EmailSettings!
  """Send a test email using the tenant's effective email settings."""
  testEmailSettings(to: String): Boolean!
  """Define a salary structure for an employee."""
  createSalaryStructure(input: CreateSalaryStructureInput!): SalaryStructure!
  """Update an existing salary structure."""
  updateSalaryStructure(id: ID!, input: UpdateSalaryStructureInput!): SalaryStructure!
  """Delete a salary structure by ID."""
  deleteSalaryStructure(id: ID!): Boolean!
  """Generate a payroll record for an employee for a given month."""
  generatePayroll(input: GeneratePayrollInput!): Payroll!
  """
  Advance payroll status (draft → approved → paid) and record payment details.
  """
  updatePayrollStatus(id: ID!, input: UpdatePayrollStatusInput!): Payroll!
  """Delete a payroll record."""
  deletePayroll(id: ID!): Boolean!
  """Enroll a new student linked to an existing user account."""
  createStudent(input: CreateStudentInput!): Student!
  """Update an existing student's enrollment details and personal info."""
  updateStudent(id: ID!, input: UpdateStudentInput!): Student!
  """Delete a student record."""
  deleteStudent(id: ID!): Boolean!
  """Delete every student in the tenant in one transaction. Returns the number removed."""
  deleteAllStudents: Int!
  """Create a new course/programme."""
  createCourse(input: CreateCourseInput!): Course!
  """Update an existing course."""
  updateCourse(id: ID!, input: UpdateCourseInput!): Course!
  """Delete a course."""
  deleteCourse(id: ID!): Boolean!
  """Create a batch under a course."""
  createCourseBatch(courseId: ID!, startYear: Int!): CourseBatch!
  """Delete a course batch."""
  deleteCourseBatch(id: ID!): Boolean!
  """Create a new subject."""
  createSubject(input: CreateSubjectInput!): Subject!
  """Update an existing subject."""
  updateSubject(id: ID!, input: UpdateSubjectInput!): Subject!
  """Delete a subject."""
  deleteSubject(id: ID!): Boolean!
  """Replace the subjects assigned to one semester of a course's curriculum."""
  setCurriculumSubjects(input: SetCurriculumSubjectsInput!): [CurriculumSubject!]!
  """Create a new exam schedule."""
  createExamSchedule(input: CreateExamScheduleInput!): ExamSchedule!
  """Update an existing exam schedule."""
  updateExamSchedule(id: ID!, input: UpdateExamScheduleInput!): ExamSchedule!
  """Toggle the published state of an exam schedule."""
  publishExamSchedule(id: ID!, published: Boolean!): ExamSchedule!
  """Delete an exam schedule."""
  deleteExamSchedule(id: ID!): Boolean!
  """Create a department-scoped exam type (assessment definition)."""
  createExamType(input: CreateExamTypeInput!): ExamType!
  """Update an existing exam type."""
  updateExamType(id: ID!, input: UpdateExamTypeInput!): ExamType!
  """Delete an exam type."""
  deleteExamType(id: ID!): Boolean!
  """Delete a semester by ID."""
  deleteSemester(id: ID!): Boolean!
  """Delete an academic year and all its semesters."""
  deleteAcademicYear(id: ID!): Boolean!
  """Record a mark entry for a student."""
  createMark(input: CreateMarkInput!): Mark!
  """Update marks obtained and max marks for an existing entry."""
  updateMark(id: ID!, input: UpdateMarkInput!): Mark!
  """Delete a single mark entry."""
  deleteMark(id: ID!): Boolean!
  """Delete multiple mark entries by ID. Returns the count deleted."""
  deleteMarks(ids: [ID!]!): Int!
  """Delete all mark entries matching the filter criteria. Returns the count deleted."""
  deleteMarksByFilter(studentId: String, subjectId: String, examType: String, status: String): Int!
  """
  Publish results matching the filter criteria. Returns the count of records published.
  """
  publishResults(input: PublishResultsInput!): Int!
  """Create or replace the tenant's grading scheme and its grade bands (admin)."""
  saveGradingScheme(input: SaveGradingSchemeInput!): GradingScheme!
  """Record attendance for a single entity (student or employee)."""
  markAttendance(input: MarkAttendanceInput!): AttendanceRecord!
  """Record attendance for multiple entities in one request."""
  bulkMarkAttendance(inputs: [MarkAttendanceInput!]!): [AttendanceRecord!]!
  """Submit a leave application."""
  applyLeave(input: ApplyLeaveInput!): LeaveRecord!
  """Approve or reject a leave application (admin only)."""
  reviewLeave(id: ID!, input: ReviewLeaveInput!): LeaveRecord!
  """Create a new leave type configuration."""
  createLeaveType(input: CreateLeaveTypeInput!): LeaveTypeConfig!
  """Update an existing leave type."""
  updateLeaveType(id: ID!, input: UpdateLeaveTypeInput!): LeaveTypeConfig!
  """Delete a leave type."""
  deleteLeaveType(id: ID!): Boolean!
  """Create a single timetable slot."""
  createTimetableSlot(input: CreateTimetableSlotInput!): TimetableSlot!
  """Update an existing timetable slot."""
  updateTimetableSlot(id: ID!, input: UpdateTimetableSlotInput!): TimetableSlot!
  """Delete a timetable slot."""
  deleteTimetableSlot(id: ID!): Boolean!
  """
  Replace all timetable slots for a course/semester in one atomic operation.
  """
  bulkCreateTimetableSlots(input: BulkCreateTimetableSlotsInput!): [TimetableSlot!]!
  """Create a college calendar event."""
  createEvent(input: CreateEventInput!): EventItem!
  """Update a calendar event."""
  updateEvent(id: ID!, input: UpdateEventInput!): EventItem!
  """Delete a calendar event."""
  deleteEvent(id: ID!): Boolean!
  """Create a tenant event category."""
  createEventCategory(input: CreateEventCategoryInput!): EventCategory!
  """Update a tenant event category."""
  updateEventCategory(id: ID!, input: UpdateEventCategoryInput!): EventCategory!
  """Delete a tenant event category."""
  deleteEventCategory(id: ID!): Boolean!
  """Create an announcement targeted at specific roles."""
  createAnnouncement(input: CreateAnnouncementInput!): AnnouncementItem!
  """Update an existing announcement."""
  updateAnnouncement(id: ID!, input: UpdateAnnouncementInput!): AnnouncementItem!
  """Delete an announcement."""
  deleteAnnouncement(id: ID!): Boolean!
  """Mark a specific notification as read."""
  markNotificationRead(id: ID!): Boolean!
  """Mark all notifications for the current user as read."""
  markAllNotificationsRead: Boolean!
  """Delete a notification."""
  deleteNotification(id: ID!): Boolean!
  """Send a notification to a specific user (admin only)."""
  sendNotification(input: SendNotificationInput!): NotificationItem!
  """Create a new learning goal (admin)."""
  createLearningGoal(input: CreateLearningGoalInput!): LearningGoal!
  """Update a learning goal's metadata (admin)."""
  updateLearningGoal(id: ID!, input: UpdateLearningGoalInput!): LearningGoal!
  """Delete a learning goal and all descendants (admin)."""
  deleteLearningGoal(id: ID!): Boolean!
  """Create a section within a goal (admin)."""
  createLearningSection(input: CreateLearningSectionInput!): LearningSection!
  """Update a section (admin)."""
  updateLearningSection(id: ID!, input: UpdateLearningSectionInput!): LearningSection!
  """Delete a section (admin)."""
  deleteLearningSection(id: ID!): Boolean!
  """Create a unit (video + text) within a section (admin)."""
  createLearningUnit(input: CreateLearningUnitInput!): LearningItem!
  """Update a unit (admin)."""
  updateLearningUnit(id: ID!, input: UpdateLearningUnitInput!): LearningItem!
  """Delete a unit (admin)."""
  deleteLearningUnit(id: ID!): Boolean!
  """Request a pre-signed URL to upload a unit video (admin)."""
  uploadUnitVideo(unitId: ID!, filename: String!, contentType: String!): ModuleVideoUpload!
  """Create an assignment (admin)."""
  createLearningAssignment(input: CreateLearningAssignmentInput!): LearningItem!
  """Update an assignment (admin)."""
  updateLearningAssignment(id: ID!, input: UpdateLearningAssignmentInput!): LearningItem!
  """Delete an assignment (admin)."""
  deleteLearningAssignment(id: ID!): Boolean!
  """Create a quiz question (admin)."""
  createLearningQuestion(input: CreateLearningQuestionInput!): LearningQuestion!
  """Update a quiz question (admin)."""
  updateLearningQuestion(id: ID!, input: UpdateLearningQuestionInput!): LearningQuestion!
  """Delete a quiz question (admin)."""
  deleteLearningQuestion(id: ID!): Boolean!
  """Submit a quiz attempt — auto-graded; returns score and progress row."""
  submitQuiz(employeeGoalProgressId: ID!, assignmentId: ID!, answers: [QuizAnswerInput!]!): QuizSubmissionResult!
  """
  Assign a goal to a department — creates progress rows for every employee.
  """
  assignGoalToDepartment(goalId: ID!, departmentId: ID!): GoalAssignmentItem!
  """
  Remove a goal-department assignment and cascade-delete its progress rows.
  """
  removeGoalAssignment(assignmentId: ID!): Boolean!
  """
  Update a single item's progress (employee marks units; admin records scores).
  """
  updateItemProgress(input: UpdateItemProgressInput!): ItemProgress!
  """Create or update the tenant org profile."""
  updateOrgProfile(input: UpdateOrgProfileInput!): OrgProfile!
  """Update an existing department."""
  updateDepartment(id: ID!, input: UpdateDepartmentInput!): Department!
  """Delete a department (fails if employees are assigned)."""
  deleteDepartment(id: ID!): Boolean!
  """Create a new academic year."""
  createAcademicYear(input: CreateAcademicYearInput!): AcademicYear!
  """Update an existing academic year."""
  updateAcademicYear(id: ID!, input: UpdateAcademicYearInput!): AcademicYear!
  """Mark an academic year as the current one."""
  setCurrentAcademicYear(id: ID!): AcademicYear!
  """Create a new semester."""
  createSemester(input: CreateSemesterInput!): Semester!
  """Create a custom role."""
  createCustomRole(input: CreateCustomRoleInput!): CustomRole!
  """Update a custom role."""
  updateCustomRole(id: ID!, input: UpdateCustomRoleInput!): CustomRole!
  """Delete a custom role."""
  deleteCustomRole(id: ID!): Boolean!
  """Assign (or detach) a custom role to a user."""
  assignUserCustomRole(userId: ID!, customRoleId: ID): Boolean!
  """Set manager and optional department for a user."""
  assignUserManager(userId: ID!, managerId: ID, departmentId: ID): Boolean!
  """Create a new hostel block."""
  createHostelBlock(input: CreateHostelBlockInput!): HostelBlock!
  """Delete multiple hostel blocks by ID."""
  bulkDeleteHostelBlocks(ids: [ID!]!): Int!
  """Create a new hostel room."""
  createHostelRoom(input: CreateHostelRoomInput!): HostelRoom!
  """Update a hostel room."""
  updateHostelRoom(id: ID!, input: UpdateHostelRoomInput!): HostelRoom!
  """Delete multiple hostel rooms by ID (also removes their allocations)."""
  bulkDeleteHostelRooms(ids: [ID!]!): Int!
  """Allocate a hostel room to a student."""
  allocateHostelRoom(input: AllocateHostelRoomInput!): HostelAllocation!
  """Vacate a hostel allocation."""
  vacateHostelRoom(id: ID!, input: VacateHostelRoomInput!): HostelAllocation!
  """
  Delete multiple hostel allocations by ID (frees a bed for active ones).
  """
  bulkDeleteHostelAllocations(ids: [ID!]!): Int!
  """Create a room class (pricing template)."""
  createRoomClass(input: CreateRoomClassInput!): RoomClass!
  """Update a room class."""
  updateRoomClass(id: ID!, input: UpdateRoomClassInput!): RoomClass!
  """Delete a room class."""
  deleteRoomClass(id: ID!): Boolean!
  """Delete multiple room classes by ID (unlinks rooms using them)."""
  bulkDeleteRoomClasses(ids: [ID!]!): Int!
  """Create a transport route."""
  createTransportRoute(input: CreateTransportRouteInput!): TransportRoute!
  """Update a transport route."""
  updateTransportRoute(id: ID!, input: UpdateTransportRouteInput!): TransportRoute!
  """Delete a transport route."""
  deleteTransportRoute(id: ID!): Boolean!
  """Delete multiple transport routes by ID."""
  bulkDeleteTransportRoutes(ids: [ID!]!): Int!
  """Create a transport vehicle."""
  createTransportVehicle(input: CreateTransportVehicleInput!): TransportVehicle!
  """Update a transport vehicle."""
  updateTransportVehicle(id: ID!, input: UpdateTransportVehicleInput!): TransportVehicle!
  """Delete a transport vehicle."""
  deleteTransportVehicle(id: ID!): Boolean!
  """
  Delete multiple transport vehicles by ID (also removes their allocations).
  """
  bulkDeleteTransportVehicles(ids: [ID!]!): Int!
  """Allocate a vehicle to a student."""
  allocateTransportVehicle(input: AllocateTransportInput!): TransportAllocation!
  """Remove a transport allocation."""
  removeTransportAllocation(id: ID!, input: RemoveTransportAllocationInput!): TransportAllocation!
  """Delete multiple transport allocations by ID."""
  bulkDeleteTransportAllocations(ids: [ID!]!): Int!
  """Add a book to the library catalogue."""
  createLibraryBook(input: CreateLibraryBookInput!): LibraryBook!
  """Update a library book."""
  updateLibraryBook(id: ID!, input: UpdateLibraryBookInput!): LibraryBook!
  """Delete a library book."""
  deleteLibraryBook(id: ID!): Boolean!
  """Issue a book to a user."""
  issueLibraryBook(input: IssueLibraryBookInput!): LibraryIssue!
  """Return a book."""
  returnLibraryBook(id: ID!, input: ReturnLibraryBookInput!): LibraryIssue!
  """Create a holiday (supports single date or date range)."""
  createHoliday(input: CreateHolidayInput!): [Holiday!]!
  """Delete a single holiday."""
  deleteHoliday(id: ID!): Boolean!
  """Delete multiple holidays."""
  bulkDeleteHolidays(ids: [ID!]!): Int!
  """Copy holidays into another academic year."""
  copyHolidaysToAcademicYear(ids: [ID!]!, targetAcademicYearId: String!): CopyResult!
  """Update calendar generation settings."""
  updateCalendarSettings(input: UpdateCalendarSettingsInput!): CalendarSettings!
  """Auto-generate weekend holiday rows for a year."""
  generateCalendar(year: Int!): GenerateCalendarResult!
  """Create or update a single calendar day entry."""
  upsertCalendarDay(input: UpsertCalendarDayInput!): Holiday
  """Update per-tenant attendance configuration."""
  updateAttendanceSettings(input: UpdateAttendanceSettingsInput!): AttendanceSettings!
  """Create a salary template."""
  createSalaryTemplate(input: CreateSalaryTemplateInput!): SalaryTemplate!
  """Update a salary template."""
  updateSalaryTemplate(id: ID!, input: UpdateSalaryTemplateInput!): SalaryTemplate!
  """Delete a salary template (fails if in active use)."""
  deleteSalaryTemplate(id: ID!): Boolean!
  """Assign a salary template to one employee."""
  assignSalaryTemplate(input: AssignSalaryTemplateInput!): Boolean!
  """Assign a salary template to multiple employees."""
  bulkAssignSalaryTemplate(input: BulkAssignSalaryTemplateInput!): BulkAssignResult!
  """Update a salary assignment's overrides."""
  updateSalaryAssignment(id: ID!, input: UpdateSalaryAssignmentInput!): SalaryAssignment!
  """Delete a salary assignment."""
  deleteSalaryAssignment(id: ID!): Boolean!
  """Approve an approval request."""
  approveRequest(id: ID!, comment: String): ApprovalRequest!
  """Reject an approval request."""
  rejectRequest(id: ID!, comment: String): ApprovalRequest!
  "Create a fee category (a master fee code)."
  createFeeCategory(input: CreateFeeCategoryInput!): FeeCategory!
  "Update a fee category."
  updateFeeCategory(id: ID!, input: UpdateFeeCategoryInput!): FeeCategory!
  "Delete a fee category."
  deleteFeeCategory(id: ID!): Boolean!
  "Create a course fee structure (variation) with per-year line items covering the course duration."
  createFeeStructure(input: CreateFeeStructureInput!): FeeStructure!
  "Update a fee structure. Passing items replaces all line items (blocked once allocations exist)."
  updateFeeStructure(id: ID!, input: UpdateFeeStructureInput!): FeeStructure!
  "Delete a fee structure (blocked if allocations reference it)."
  deleteFeeStructure(id: ID!): Boolean!
  "Duplicate a structure (with all items) as a new variation, e.g. to create an NRI or scholarship tier."
  cloneFeeStructure(id: ID!, name: String!, code: String!): FeeStructure!
  "Create an allocation: pick a structure, frequency, and target. Installments are auto-generated and student fees materialized."
  createFeeAllocation(input: CreateFeeAllocationInput!): FeeAllocation!
  "Update an allocation. Passing installments replaces the schedule and re-syncs unpaid student fees (blocked once payments exist)."
  updateFeeAllocation(id: ID!, input: UpdateFeeAllocationInput!): FeeAllocation!
  "Remove an allocation. Deletes generated student fees that have no payments (blocked if payments exist)."
  deleteFeeAllocation(id: ID!): Boolean!
  "Re-apply an allocation to pick up newly admitted students. Returns the number of records created."
  syncFeeAllocation(id: ID!): Int!
  "Add a discount/waiver line to a student fee (only before any payment)."
  addStudentFeeDiscount(input: AddStudentFeeDiscountInput!): StudentFee!
  "Remove a discount line (only before any payment)."
  removeStudentFeeDiscount(id: ID!): StudentFee!
  "Record a payment against a student fee. Applies to installments oldest-first."
  recordFeePayment(input: RecordFeePaymentInput!): FeePayment!
  "Cancel a payment and reverse its application to installments."
  cancelFeePayment(id: ID!): FeePayment!
  "Backfill transport/hostel add-ons onto students who hold an active allocation but are missing the fee. Returns rows created."
  resyncFacilityFees: Int!
  "Define a fee add-on (an optional per-year facility charge)."
  createFeeAddOn(input: CreateFeeAddOnInput!): FeeAddOn!
  "Update a fee add-on. Amount changes only affect future attachments."
  updateFeeAddOn(id: ID!, input: UpdateFeeAddOnInput!): FeeAddOn!
  "Delete a fee add-on (blocked while attached to any student)."
  deleteFeeAddOn(id: ID!): Boolean!
  "Attach an add-on to a student fee for the given course years. Recomputes totals and unpaid installments."
  addStudentFeeAddOn(input: AddStudentFeeAddOnInput!): StudentFee!
  "Detach one add-on year from a student fee (blocked if it would drop the total below what is already paid)."
  removeStudentFeeAddOn(id: ID!): StudentFee!
  """Add a question to the bank for a curriculum subject."""
  createQuestionBankItem(input: CreateQuestionBankItemInput!): QuestionBankItem!
  """Update a question-bank item."""
  updateQuestionBankItem(id: ID!, input: UpdateQuestionBankItemInput!): QuestionBankItem!
  """Delete a question-bank item. Papers already generated keep their frozen copy."""
  deleteQuestionBankItem(id: ID!): Boolean!
  """Generate a question paper from the bank using a difficulty/unit/type rule."""
  generateQuestionPaper(input: GenerateQuestionPaperInput!): QuestionPaper!
  """Lock a draft paper. A finalized paper prints without the DRAFT watermark and cannot be edited."""
  finalizeQuestionPaper(id: ID!): QuestionPaper!
  """Delete a question paper and its items. Finalized papers cannot be deleted."""
  deleteQuestionPaper(id: ID!): Boolean!
  """Issue hall tickets to every enrolled student for an exam schedule. Idempotent per (student, schedule); ineligible students are stored held with a reason."""
  issueHallTickets(input: IssueHallTicketsInput!): HallTicketIssueResult!
  """Revoke an issued hall ticket."""
  revokeHallTicket(id: ID!): HallTicket!
  """Clear an eligibility hold and issue the ticket."""
  releaseHallTicketHold(id: ID!): HallTicket!
}

"""An in-app notification for a specific user."""
type NotificationItem {
  """Unique identifier."""
  id: ID!
  """Recipient user UUID."""
  userId: String!
  """Short notification title."""
  title: String!
  """Notification body text."""
  body: String
  """Notification type (informational, alert, reminder, etc.)."""
  type: String!
  """Category for grouping: fee | leave | payroll | attendance | general."""
  category: String!
  """UUID of the related entity (e.g. leave application ID)."""
  refId: String
  """Type of the related entity (e.g. leave, fee_payment)."""
  refType: String
  """Whether the user has read this notification."""
  isRead: Boolean!
  """ISO 8601 timestamp when the notification was created."""
  createdAt: String!
}

"""A node in the org hierarchy tree."""
type OrgNode {
  id: ID!
  name: String!
  email: String!
  role: String!
  photoUrl: String!
  managerId: ID
  departmentId: ID
  designation: String!
  children: [OrgNode!]!
}

"""Organisation branding and profile settings."""
type OrgProfile {
  id: ID!
  name: String!
  logoUrl: String!
  tagline: String!
  primaryColor: String!
  accentColor: String!
  accreditation: String!
  """Whether staff (teachers/staff) must have an email. When false they sign in by Employee ID."""
  staffEmailRequired: Boolean!
  """Whether students must have an email. When false they sign in by Roll Number."""
  studentEmailRequired: Boolean!
}

"""Boolean flags indicating which setup steps are complete."""
type OrgSetupStatus {
  orgProfile: Boolean!
  departments: Boolean!
  academicYear: Boolean!
  firstUser: Boolean!
}

"""Full org structure response — roots forest + flat list."""
type OrgStructure {
  roots: [OrgNode!]!
  users: [OrgUser!]!
}

"""Slim user representation for org structure / manager trees."""
type OrgUser {
  id: ID!
  name: String!
  email: String!
  role: String!
  photoUrl: String!
  managerId: ID
  departmentId: ID
  designation: String!
}

"""Input for creating or updating banking/PF details on an employee."""
input PaymentDetailsInput {
  """Bank name."""
  bankName: String
  """Bank account number."""
  accountNumber: String
  """Account type: savings | current."""
  accountType: String
  """IFSC code."""
  ifscCode: String
  """Branch name."""
  branchName: String
  """PF member number."""
  pfNumber: String
  """UAN number."""
  uanNumber: String
  """Employee PF contribution %."""
  pfEmployeePercent: Float
  """Employer PF contribution %."""
  pfEmployerPercent: Float
  """ESI number."""
  esiNumber: String
  """ESI dispensary."""
  esiDispensary: String
  """PAN number."""
  panNumber: String
  """Tax regime: old | new."""
  taxRegime: String
  """Form 16 reference."""
  form16Ref: String
  """NPS account number."""
  npsAccountNumber: String
  """NPS tier."""
  npsTier: String
  """Gratuity eligibility flag."""
  gratuityEligible: Boolean
}

"""A single monthly payroll record for an employee."""
type Payroll {
  """Unique identifier."""
  id: ID!
  """Employee UUID."""
  employeeId: String!
  """Payroll month (1–12)."""
  month: Int!
  """Payroll year."""
  year: Int!
  """Basic salary component."""
  basicSalary: Float!
  """House Rent Allowance."""
  hra: Float!
  """Dearness Allowance."""
  da: Float!
  """Travel Allowance."""
  ta: Float!
  """Medical allowance."""
  medicalAllowance: Float!
  """Other allowances."""
  otherAllowances: Float!
  """Per-assignment extra allowance on top of template."""
  extraAllowance: Float!
  """Gross salary (sum of all allowances + basic)."""
  grossSalary: Float!
  """PF deduction."""
  pf: Float!
  """ESI deduction."""
  esi: Float!
  """TDS deduction."""
  tds: Float!
  """Other deductions."""
  otherDeductions: Float!
  """Per-assignment extra deduction on top of template."""
  extraDeduction: Float!
  """Total deductions."""
  totalDeductions: Float!
  """Net salary after deductions."""
  netSalary: Float!
  """Total working days in the month."""
  workingDays: Int!
  """Days the employee was present."""
  presentDays: Int!
  """Days taken as leave."""
  leaveDays: Int!
  """Status: draft | approved | paid."""
  status: String!
  """Date on which salary was disbursed (YYYY-MM-DD)."""
  paymentDate: String
  """Payment mode: bank_transfer | cheque | cash."""
  paymentMode: String
  """Internal notes."""
  notes: String
  """UUID of the user who processed this payroll."""
  processedBy: String
  """Salary template name snapshotted at generation time."""
  templateName: String
  """The employee this payroll record belongs to."""
  employee: Employee
}

"""Monthly payroll aggregation row."""
type PayrollMonthRow {
  """Month label (e.g. January)."""
  month: String!
  """Total gross salary disbursed."""
  grossSalary: Float!
  """Total net salary disbursed."""
  netSalary: Float!
  """Total deductions."""
  totalDeductions: Float!
  """Number of employees paid."""
  employeeCount: Int!
}

"""Annual payroll report with monthly trend."""
type PayrollReportResult {
  """Year covered by the report."""
  year: String!
  """Total gross salary for the year."""
  totalGross: Float!
  """Total net salary for the year."""
  totalNet: Float!
  """Number of distinct employees paid during the year."""
  totalEmployees: Int!
  """Month-by-month payroll trend."""
  monthlyTrend: [PayrollMonthRow!]!
}

"""Aggregate payroll statistics for a given month."""
type PayrollSummary {
  """Total number of employees with a payroll entry."""
  totalEmployees: Int!
  """Sum of all gross salaries."""
  totalGross: Float!
  """Sum of all deductions."""
  totalDeductions: Float!
  """Sum of all net salaries."""
  totalNet: Float!
  """Number of records in draft status."""
  draftCount: Int!
  """Number of records in approved status."""
  approvedCount: Int!
  """Number of records in paid status."""
  paidCount: Int!
}

"""Filter criteria for bulk-publishing results."""
input PublishResultsInput {
  """Exam type filter."""
  examType: String
  """Subject name filter."""
  subject: String
  """Semester filter."""
  semester: Int
  """Course UUID filter."""
  courseId: String
}

"""Root query type — all read operations."""
type Query {
  """Health check. Returns true when the API is up."""
  health: Boolean!
  """List suppliers. Pass active to filter by active flag."""
  vendors(active: Boolean): [Vendor!]!
  """List purchase orders, optionally filtered by status and/or vendor."""
  purchaseOrders(status: String, vendorId: String): [PurchaseOrder!]!
  """One purchase order with its line items."""
  purchaseOrder(id: ID!): PurchaseOrder
  """List supplier invoices, optionally filtered by payment status."""
  purchaseInvoices(status: String): [PurchaseInvoice!]!
  """Batches for a drug, ordered earliest-expiry-first (FEFO)."""
  drugBatches(drugId: ID!): [DrugBatch!]!
  """Drug batches expiring within the given number of days (pharmacy dashboard)."""
  expiringDrugs(days: Int!): [DrugBatch!]!
  """
  Platform-wide analytics for the super-admin dashboard: tenant growth, people
  totals, subscription mix and revenue, and quota utilisation. Aggregates
  across every customer tenant (the internal platform tenant is excluded).
  Super-admin only.
  """
  platformAnalytics: PlatformAnalytics!
  """The calling tenant's own email (SMTP) settings."""
  emailSettings: EmailSettings!
  """Whether the calling tenant can currently send email, and why."""
  emailSendStatus: EmailSendStatus!
  """
  List all employees in the tenant, with user, department, and payment detail associations.
  """
  employees: [Employee!]!
  """Fetch a single employee by ID."""
  employee(id: ID!): Employee
  """List all departments in the tenant."""
  departments: [Department!]!
  """List all user accounts in the tenant."""
  users: [User!]!
  """List salary structures, optionally filtered by employee."""
  salaryStructures(
    """Filter by employee UUID."""
    employeeId: ID
  ): [SalaryStructure!]!
  """List payroll records. All filters are optional and combinable."""
  payrolls(
    """Payroll month (1–12)."""
    month: Int
    """Payroll year (e.g. 2025)."""
    year: Int
    """Filter to a single employee."""
    employeeId: ID
    """Filter by status: draft | approved | paid."""
    status: String
  ): [Payroll!]!
  """Payroll records for the currently authenticated employee."""
  myPayrolls: [Payroll!]!
  """Aggregate payroll summary for a given month/year."""
  payrollSummary(
    """Month (1–12). Omit for the current month."""
    month: Int
    """Year (e.g. 2025). Omit for the current year."""
    year: Int
  ): PayrollSummary!
  """List students, optionally filtered by course and/or semester."""
  students(
    """Filter by course UUID."""
    courseId: String
    """Filter by semester number."""
    semester: Int
  ): [Student!]!
  """Fetch a single student by ID."""
  student(id: ID!): Student
  """List all courses offered by the institution."""
  courses: [Course!]!
  """List batches for a given course."""
  courseBatches(courseId: ID!): [CourseBatch!]!
  """List subjects, optionally filtered by department or a search term."""
  subjects(
    """Filter by department UUID."""
    departmentId: String
    """Full-text search on subject name or code."""
    search: String
  ): [Subject!]!
  """Fetch a single subject by ID."""
  subject(id: ID!): Subject
  """List the curriculum (assigned subjects per semester) for a course."""
  curriculum(courseId: ID!): [CurriculumSubject!]!
  """List all academic years defined for the tenant."""
  academicYears: [AcademicYear!]!
  """List exam schedules, optionally filtered by semester and/or exam type."""
  examSchedules(
    """Semester number (e.g. 3)."""
    semesterNumber: Int
    """Exam type: internal | external | practical."""
    examType: String
  ): [ExamSchedule!]!
  """List exam types (assessment definitions), optionally filtered by department. Org-wide types are always included. Returns active types only unless includeInactive is true."""
  examTypes(
    """Filter to a department UUID. Org-wide types (blank department) are always included."""
    departmentId: String
    """Include inactive exam types too."""
    includeInactive: Boolean
  ): [ExamType!]!
  """Query mark entries. All filters are optional. Supports offset pagination via limit/offset."""
  marks(
    """Filter by student UUID."""
    studentId: String
    """Filter by subject UUID."""
    subjectId: String
    """Exam type: internal | external | practical."""
    examType: String
    """Semester number."""
    semester: Int
    """Max rows to return (default 50)."""
    limit: Int
    """Rows to skip for pagination."""
    offset: Int
    """Filter by mark status: draft | submitted | approved."""
    status: String
  ): [Mark!]!
  """Total count of marks matching the same filters (for display)."""
  marksCount(studentId: String, subjectId: String, examType: String, status: String): Int!
  """Fetch marks that have been published to students."""
  publishedResults(
    """Exam type filter."""
    examType: String
    """Subject name or UUID filter."""
    subject: String
    """Semester filter."""
    semester: Int
    """Course UUID filter."""
    courseId: String
  ): [Mark!]!
  """Aggregate pass/fail summary for a course semester."""
  resultSummary(
    """Course UUID."""
    courseId: String!
    """Semester number."""
    semester: Int!
  ): ResultSummary!
  """The tenant's grading configuration (created with defaults on first read)."""
  gradingScheme: GradingScheme!
  """
  Compute a student's semester-wise and cumulative results from published marks
  using the tenant's grading scheme. Students get their own result; admins and
  teachers may pass a studentId.
  """
  studentAcademicResult(studentId: String): AcademicResult!
  """Query attendance records. All filters are optional."""
  attendance(
    """UUID of the student or employee."""
    entityId: String
    """Entity type: student | employee."""
    entityType: String
    """Subject UUID (for student attendance)."""
    subjectId: String
    """Date in YYYY-MM-DD format."""
    date: String
    """Maximum records to return (default 100, max 500)."""
    limit: Int
    """Number of records to skip for pagination."""
    offset: Int
    """Full-text search: matches entity name, roll number / employee code, remarks, status, date."""
    search: String
  ): [AttendanceRecord!]!
  """
  Per-entity attendance summary (total, present, absent, late, percentage).
  """
  attendanceSummary(
    """Entity type: student | employee."""
    entityType: String
  ): [AttendanceSummaryRow!]!
  """
  Students whose attendance percentage falls below the configured threshold.
  """
  attendanceShortage: ShortageList!
  """
  List leave applications visible to the caller, optionally filtered by status.
  """
  leaves(
    """Status filter: pending | approved | rejected."""
    status: String
  ): [LeaveRecord!]!
  """List all leave type configurations active in the tenant."""
  leaveTypes: [LeaveTypeConfig!]!
  """Leave balance for the currently authenticated user."""
  myLeaveBalance: [LeaveBalance!]!
  """Admin: list all leave balances, optionally filtered by year or user."""
  leaveBalances(
    """Academic/calendar year (e.g. 2025)."""
    year: Int
    """User UUID."""
    userId: String
  ): [LeaveBalance!]!
  """Key counts for the dashboard summary cards."""
  dashboardStats: DashboardStats!
  """Attendance report with daily breakdown for a date range."""
  attendanceReport(
    """Start date in YYYY-MM-DD format."""
    fromDate: String
    """End date in YYYY-MM-DD format."""
    toDate: String
    """Entity type: student | employee."""
    entityType: String
    """Subject UUID (for student reports)."""
    subjectId: String
  ): AttendanceReportResult!
  """Marks report with grade distribution and per-subject averages."""
  marksReport(
    """Course UUID."""
    courseId: String
    """Semester number as a string (e.g. '3')."""
    semesterNumber: String
    """Academic year UUID."""
    academicYearId: String
    """Assessment type: internal | external | practical."""
    assessmentType: String
  ): MarksReportResult!
  """
  Leave report with status breakdown, monthly trend, and department breakdown.
  """
  leaveReport(
    """Year as a string (e.g. '2025')."""
    year: String
    """Department name filter."""
    department: String
  ): LeaveReportResult!
  """Fee collection report grouped by month, payment mode, and category."""
  feeReport(
    """Academic year UUID."""
    academicYearId: String
  ): FeeReportResult!
  """Payroll report with monthly salary trend for a year."""
  payrollReport(
    """Year as a string (e.g. '2025')."""
    year: String
  ): PayrollReportResult!
  """Query timetable slots. All filters are optional and combinable."""
  timetable(
    """Academic year UUID."""
    academicYearId: String
    """Course UUID."""
    courseId: String
    """Semester number."""
    semester: Int
    """Section label (e.g. 'A')."""
    section: String
    """Day of week: Monday | Tuesday | … | Saturday."""
    dayOfWeek: String
    """Filter by assigned employee UUID."""
    employeeId: String
  ): [TimetableSlot!]!
  """List college calendar events, optionally filtered by category."""
  events(
    """Event category: holiday | exam | cultural | sports | other."""
    category: String
  ): [EventItem!]!
  """List tenant-defined event categories."""
  eventCategories: [EventCategory!]!
