}

"""
Input for updating a user account. All fields are optional — omit to keep current value.
"""
input UpdateUserInput {
  """New email address."""
  email: String
  """New display name."""
  name: String
  """New role."""
  role: String
  """Reset password (will be hashed). Omit to keep the existing one."""
  password: String
  """Toggle active status."""
