}

input UpsertCalendarDayInput {
  date: String!
  type: String!
  name: String
}

"""A user account that can log in to the system."""
type User {
  """Unique identifier."""
  id: ID!
  """Email address — used as the login credential."""
  email: String!
  """Display name."""
  name: String!
  """Role: super_admin | admin | teacher | staff | student."""
  role: String!
  """Whether the account is active and can authenticate."""
  isActive: Boolean!
}

input VacateHostelRoomInput {
  vacateDate: String!
}

"""A master fee code (e.g. Tuition, Transport, Food, Hostel)."""
type FeeCategory {
  "Unique identifier."
  id: ID!
  "Category name."
  name: String!
  "Short code (e.g. TUITION, TRANSPORT)."
  code: String!
  "Optional description."
  description: String
  "Whether this category is currently active."
  isActive: Boolean!
}

"""One line of a fee structure: a category amount for one course year."""
type FeeStructureItem {
  "Unique identifier."
  id: ID!
  "Fee category UUID."
  feeCategoryId: String!
  "Course year this amount belongs to (1-based)."
  yearNumber: Int!
  "Amount for this category in this year."
  amount: Float!
  "Fee category object."
  feeCategory: FeeCategory
}

"""Total fee amount of one course year within a structure."""
type FeeYearTotal {
  "Course year (1-based)."
  yearNumber: Int!
  "Sum of item amounts for the year."
  amount: Float!
}

"""
One fee variation of a course covering the entire course duration
(e.g. "Regular", "NRI Quota", "2026 Scholarship"). Structures are grouped
by course; line items define per-year category amounts.
"""
type FeeStructure {
  "Unique identifier."
  id: ID!
  "Course UUID this structure belongs to."
  courseId: String!
  "Variation name (e.g. Regular, NRI Quota, Merit Scholarship)."
  name: String!
  "Short unique code."
  code: String!
  "Optional intake batch UUID this variation is limited to."
  batchId: String
  "Optional description."
  description: String
  "Whether this structure is active."
  isActive: Boolean!
  "Total payable across the whole course duration."
  totalAmount: Float!
  "Per-year totals."
  yearTotals: [FeeYearTotal!]!
  "Number of allocations created from this structure."
  allocationCount: Int!
  "Per-year line items."
  items: [FeeStructureItem!]!
  "Course object."
  course: Course
  "Intake batch object."
  batch: CourseBatch
}

"""One slot of an allocation's payment schedule."""
type FeeAllocationInstallment {
  "Unique identifier."
  id: ID!
  "Order of the installment (1-based)."
  sequence: Int!
  "Label (e.g. Year 1, Semester 3, Full Payment)."
  label: String!
  "Course year this slot belongs to (0 = n/a)."
  yearNumber: Int!
  "Due date (YYYY-MM-DD)."
  dueDate: String
  "Installment amount."
  amount: Float!
}

"""
An allocation applies a course fee structure to students with a payment
schedule: all at once, yearly, or semester-wise. Installments are
auto-generated from the structure's per-year amounts and stay editable until
payments exist. Creating an allocation materializes student fee records.
"""
type FeeAllocation {
  "Unique identifier."
  id: ID!
  "Fee structure UUID."
  feeStructureId: String!
  "Allocation name."
  name: String!
  "Payment frequency: one_time | yearly | semester."
  frequency: String!
  "Allocation target: course | batch | student."
  targetType: String!
  "UUID of the target entity."
  targetId: String!
  "Display name of the target."
  targetName: String!
  "Total payable under this allocation."
  totalAmount: Float!
  "Whether this allocation is active."
  isActive: Boolean!
  "Number of student fee records generated."
  studentCount: Int!
  "Installment schedule."
  installments: [FeeAllocationInstallment!]!
  "The source structure."
  feeStructure: FeeStructure
}

"""A discount/waiver line on a student fee."""
type StudentFeeDiscount {
  "Unique identifier."
  id: ID!
  "Label (e.g. Merit Scholarship)."
  label: String!
  "fixed | percent."
  discountType: String!
  "Configured value (amount or percentage)."
  value: Float!
  "Resolved discount amount in currency."
  amount: Float!
  "Optional remarks."
  remarks: String
}

"""One due slot of a student fee."""
type StudentFeeInstallment {
  "Unique identifier."
  id: ID!
  "Order of the installment (1-based)."
  sequence: Int!
  "Label (e.g. Year 1, Semester 3)."
  label: String!
  "Due date (YYYY-MM-DD)."
  dueDate: String
  "Amount due in this installment."
  amount: Float!
  "Amount paid so far."
  paidAmount: Float!
  "pending | partial | paid."
  status: String!
  "Whether the due date has passed without full payment."
  isOverdue: Boolean!
}

"""The materialized fee record of one student under one allocation."""
type StudentFee {
  "Unique identifier."
  id: ID!
  "Attached add-ons (per course year)."
  addOns: [StudentFeeAddOn!]!
  "Student UUID."
  studentId: String!
  "Fee allocation UUID."
  feeAllocationId: String!
  "Total before discounts."
  grossAmount: Float!
  "Total discount applied."
  discountAmount: Float!
  "Net payable (gross - discounts)."
  netAmount: Float!
  "Amount paid so far."
  paidAmount: Float!
  "pending | partial | paid."
  status: String!
  "Discount lines."
  discounts: [StudentFeeDiscount!]!
  "Installment schedule."
  installments: [StudentFeeInstallment!]!
  "Student object."
  student: Student
  "Fee allocation object."
  feeAllocation: FeeAllocation
}

"""A recorded payment against a student fee."""
type FeePayment {
  "Unique identifier."
  id: ID!
  "Student fee UUID."
  studentFeeId: String!
  "Student UUID."
  studentId: String!
  "Specific installment paid (null = applied oldest-first)."
  installmentId: String
  "Amount paid."
  amount: Float!
  "Payment date (YYYY-MM-DD)."
  paymentDate: String!
  "Payment mode: cash | online | cheque | dd."
  paymentMode: String!
  "Bank transaction reference or cheque number."
  transactionRef: String
  "paid | cancelled."
  status: String!
  "Internal remarks."
  remarks: String
  "UUID of the staff who received the payment."
  receivedBy: String
  "System-generated receipt number."
  receiptNumber: String!
  "Student object."
  student: Student
  "Student fee object."
  studentFee: StudentFee
}

"""High-level fee collection summary."""
type FeeCollectionSummary {
  "Total amount collected."
  totalCollected: Float!
  "Number of payments recorded."
  paymentCount: Int!
  "Total outstanding across all student fees."
  pendingDues: Float!
  "Total net payable across all student fees."
  totalExpected: Float!
}

"""Per-course collection row for the fees overview."""
type FeeCourseRow {
  "Course UUID."
  courseId: String!
  "Course name."
  courseName: String!
  "Total net payable for the course."
  expected: Float!
  "Total collected for the course."
  collected: Float!
  "Outstanding for the course."
  pending: Float!
  "Students with fee records in the course."
  studentCount: Int!
}

"""Analytics payload for the fees overview tab."""
type FeeOverview {
  "Headline totals."
  summary: FeeCollectionSummary!
  "Collection broken down by course."
  byCourse: [FeeCourseRow!]!
  "Collection broken down by payment mode."
  byMode: [FeeModeRow!]!
  "Monthly collection trend."
  byMonth: [FeeMonthRow!]!
  "Most recent payments."
  recentPayments: [FeePayment!]!
}

"""Input for creating a fee category."""
input CreateFeeCategoryInput {
  "Category name."
  name: String!
  "Short code."
  code: String!
  "Optional description."
  description: String
}

"""Input for updating a fee category."""
input UpdateFeeCategoryInput {
  "Updated name."
  name: String
  "Updated description."
  description: String
  "Toggle active status."
  isActive: Boolean
}

"""One per-year line item of a fee structure."""
input FeeStructureItemInput {
  "Fee category UUID."
  feeCategoryId: String!
  "Course year (1-based)."
  yearNumber: Int!
  "Amount."
  amount: Float!
}

"""Input for creating a course fee structure (variation)."""
input CreateFeeStructureInput {
  "Course UUID."
  courseId: String!
  "Variation name (e.g. Regular, NRI Quota)."
  name: String!
  "Short unique code."
  code: String!
  "Optional intake batch UUID."
  batchId: String
  "Optional description."
  description: String
  "Per-year line items (at least one)."
  items: [FeeStructureItemInput!]!
}

"""Input for updating a fee structure."""
input UpdateFeeStructureInput {
  "Updated variation name."
  name: String
  "Updated description."
  description: String
  "Updated intake batch UUID (empty string clears it)."
  batchId: String
  "Toggle active status."
  isActive: Boolean
  "Replacement line items (omit to keep current items)."
  items: [FeeStructureItemInput!]
}

"""One installment override for an allocation schedule."""
input FeeAllocationInstallmentInput {
  "Label (e.g. Year 1)."
  label: String!
  "Course year this slot belongs to (0 = n/a)."
  yearNumber: Int
  "Due date (YYYY-MM-DD)."
  dueDate: String
  "Amount. All installments must sum to the structure total."
  amount: Float!
}

"""
Input for creating a fee allocation. Omit installments to auto-generate them
from the frequency: one_time = single payment, yearly = one per course year,
semester = two per course year.
"""
input CreateFeeAllocationInput {
  "Fee structure UUID."
  feeStructureId: String!
  "Allocation name (defaults to structure + frequency)."
  name: String
  "one_time | yearly | semester."
  frequency: String!
  "course | batch | student."
  targetType: String!
  "UUID of the course, batch, or student."
  targetId: String!
  "Due date of the first installment (YYYY-MM-DD). Later slots are spaced by frequency."
  firstDueDate: String
  "Custom installment schedule (overrides auto-generation)."
  installments: [FeeAllocationInstallmentInput!]
}

"""Input for updating a fee allocation."""
input UpdateFeeAllocationInput {
  "Updated name."
  name: String
  "Toggle active status."
  isActive: Boolean
  "Replacement installment schedule (blocked once payments exist)."
  installments: [FeeAllocationInstallmentInput!]
}

"""Input for adding a discount to a student fee."""
input AddStudentFeeDiscountInput {
  "Student fee UUID."
  studentFeeId: String!
  "Label (e.g. Merit Scholarship)."
  label: String!
  "fixed | percent."
  discountType: String!
  "Amount (for fixed) or percentage 0-100 (for percent)."
  value: Float!
  "Optional remarks."
  remarks: String
}

"""Input for recording a fee payment."""
input RecordFeePaymentInput {
  "Student fee UUID being paid."
  studentFeeId: String!
  "Pay a specific installment (omit to apply oldest-first)."
  installmentId: String
  "Amount paid."
  amount: Float!
  "Payment date (YYYY-MM-DD). Defaults to today."
  paymentDate: String
  "Payment mode: cash | online | cheque | dd."
  paymentMode: String
  "Transaction reference."
  transactionRef: String
  "Remarks."
  remarks: String
}

"""An optional facility charge (Transport, Hostel, Mess…) that admins attach
to individual students on top of their base course fee. Attach/remove per
course year — no separate fee structure needed."""
type FeeAddOn {
  "Unique identifier."
  id: ID!
  "Add-on name (e.g. College Bus, Hostel Room)."
  name: String!
  "Short unique code."
  code: String!
  "Kind: other | transport | hostel. transport/hostel auto-attach on allocation."
  kind: String!
  "Fee category UUID this add-on bills under."
  feeCategoryId: String!
  "Charge per course year."
  amountPerYear: Float!
  "Optional description."
  description: String
  "Whether this add-on can currently be attached."
  isActive: Boolean!
  "Number of student-fee attachments."
  studentCount: Int!
  "Fee category object."
  feeCategory: FeeCategory
}

"""One add-on attached to one student fee for one course year."""
type StudentFeeAddOn {
  "Unique identifier."
  id: ID!
  "Fee add-on UUID."
  feeAddOnId: String!
  "Course year the charge applies to."
  yearNumber: Int!
  "Charged amount (copied from the add-on at attach time)."
  amount: Float!
  "Add-on object."
  feeAddOn: FeeAddOn
}

"""Input for defining a fee add-on."""
input CreateFeeAddOnInput {
  "Add-on name."
  name: String!
  "Short unique code."
  code: String!
  "Kind: other | transport | hostel. Defaults to other."
  kind: String
  "Fee category UUID to bill under."
  feeCategoryId: String!
  "Charge per course year."
  amountPerYear: Float!
  "Optional description."
  description: String
}

"""Input for updating a fee add-on."""
input UpdateFeeAddOnInput {
  "Updated name."
  name: String
  "Updated kind: other | transport | hostel."
  kind: String
  "Updated per-year charge (affects future attachments only)."
  amountPerYear: Float
  "Updated description."
  description: String
  "Toggle active status."
  isActive: Boolean
}

"""Input for attaching an add-on to a student fee."""
input AddStudentFeeAddOnInput {
  "Student fee UUID."
  studentFeeId: String!
  "Fee add-on UUID."
  feeAddOnId: String!
  "Course years to charge it in (e.g. [1, 2, 3, 4])."
  yearNumbers: [Int!]!
}

# ── Role Access Matrix ─────────────────────────────────────────────────────────
# Per-tenant, per-role control over which modules (pages) a role can access and
# what CRUD actions it may perform. Managed by tenant admins on the Access
# Control page; enforced in the GraphQL layer and used to drive the nav.

"""CRUD flags for one role on one module."""
type ModuleAccess {
  """Module id (see AccessMatrix.modules)."""
  module: String!
  canView: Boolean!
  canCreate: Boolean!
  canEdit: Boolean!
  canDelete: Boolean!
}

"""Display metadata for a module row in the matrix."""
type AccessModuleMeta {
  id: String!
  label: String!
  group: String!
}

"""One role column in the matrix with its effective per-module access."""
type RoleAccess {
  """"system" for built-in roles, "custom" for tenant CustomRoles."""
  subjectType: String!
  """Role name (system) or CustomRole id (custom)."""
  subjectKey: String!
  """Human-friendly role label."""
  label: String!
  """True when this column is a tenant CustomRole."""
  isCustom: Boolean!
  modules: [ModuleAccess!]!
}

"""The full role access matrix for the tenant."""
type AccessMatrix {
  modules: [AccessModuleMeta!]!
  roles: [RoleAccess!]!
}

"""CRUD flags for one module when saving a role's access."""
input ModuleAccessInput {
  module: String!
  canView: Boolean!
  canCreate: Boolean!
  canEdit: Boolean!
  canDelete: Boolean!
}

"""Replace one role's access across the given modules."""
input UpdateRoleAccessInput {
  subjectType: String!
  subjectKey: String!
  modules: [ModuleAccessInput!]!
}

extend type Query {
  """Full role access matrix for the tenant (admin only)."""
  accessMatrix: AccessMatrix!
  """The effective module access for the currently authenticated user."""
  myAccess: [ModuleAccess!]!
}

extend type Mutation {
  """Upsert one role's access across modules (admin only)."""
  updateRoleAccess(input: UpdateRoleAccessInput!): RoleAccess!
  """Reset one role's access back to the built-in defaults (admin only)."""
  resetRoleAccess(subjectType: String!, subjectKey: String!): RoleAccess!
}

"""A tenant's outbound email (SMTP) configuration. The stored password is never
returned — only whether one is set (hasPassword)."""
type EmailSettings {
  """Whether this tenant's own sending is switched on."""
  enabled: Boolean!
  """Display name on the From header."""
  fromName: String!
  """From address used as the envelope sender."""
  fromEmail: String!
  """SMTP server hostname."""
  smtpHost: String!
  """SMTP server port (587 STARTTLS, 465 implicit TLS)."""
  smtpPort: Int!
  """SMTP auth username."""
  smtpUsername: String!
  """Whether to use implicit TLS (port 465) instead of STARTTLS."""
  useTls: Boolean!
  """Whether an SMTP password is stored (the value itself is never exposed)."""
  hasPassword: Boolean!
}

"""Why a tenant can or cannot currently send email."""
type EmailSendStatus {
  """Super-admin capability switch for this tenant."""
  allowed: Boolean!
  """The tenant admin's own on/off toggle."""
  enabled: Boolean!
  """Whether a usable SMTP transport exists (own or the platform fallback)."""
  transportConfigured: Boolean!
  """allowed && enabled && transportConfigured."""
  canSend: Boolean!
}

"""Outcome of issuing a password-setup invite."""
type InviteResult {
  """The accept link (always present so it can be copied manually)."""
  link: String!
  """Whether the invite email was actually delivered."""
  sent: Boolean!
  """When the link stops working (RFC3339)."""
  expiresAt: String!
}

"""Partial update of a tenant's email settings. Null fields are left unchanged;
an empty smtpPassword keeps the stored one."""
input UpdateEmailSettingsInput {
  enabled: Boolean
  fromName: String
  fromEmail: String
  smtpHost: String
  smtpPort: Int
  smtpUsername: String
  smtpPassword: String
  useTls: Boolean
}

# ---------------------------------------------------------------------------
# Platform analytics (super-admin dashboard). Every figure aggregates across
# customer tenants and excludes the internal platform tenant.
# ---------------------------------------------------------------------------

"""Top-level platform analytics payload for the super-admin dashboard."""
type PlatformAnalytics {
  """Tenant counts, growth and type mix."""
  tenants: PlatformTenantStats!
  """People totals across all tenants."""
  people: PlatformPeopleStats!
  """Subscription mix, billing status and estimated revenue."""
  subscriptions: PlatformSubscriptionStats!
  """Quota utilisation and breaches across tenants."""
  quota: PlatformQuotaStats!
  """When this snapshot was computed (RFC3339)."""
  generatedAt: String!
}

"""Tenant counts and growth over time."""
type PlatformTenantStats {
  total: Int!
  active: Int!
  suspended: Int!
  """Tenants created in the current calendar month."""
  newThisMonth: Int!
  """Signups per month for the trailing 12 months, oldest first."""
  growth: [TenantGrowthPoint!]!
  """Tenant count grouped by canonical type (education/corporate/...)."""
  byType: [TenantTypeCount!]!
}

"""One month bucket of tenant growth."""
type TenantGrowthPoint {
  """Month bucket, formatted YYYY-MM."""
  month: String!
  """Tenants created during the month."""
  created: Int!
  """Cumulative tenant count through the end of the month."""
  cumulative: Int!
}

"""Tenant count for a single canonical type."""
type TenantTypeCount {
  type: String!
  count: Int!
}

"""People totals across all customer tenants."""
type PlatformPeopleStats {
  students: Int!
  employees: Int!
  """All user accounts (excluding the platform tenant)."""
  users: Int!
  """Largest tenants by combined student + employee headcount (top 8)."""
  topTenants: [TenantPeopleCount!]!
}

"""Per-tenant people headcount."""
type TenantPeopleCount {
  tenantId: String!
  tenantName: String!
  students: Int!
  employees: Int!
}

"""Subscription mix, billing status and estimated revenue."""
type PlatformSubscriptionStats {
  """Tenants with an active or trial subscription."""
  active: Int!
  """Customer tenants with no subscription assigned."""
  unsubscribed: Int!
  """Active/trial subscriptions whose end date is within the next 30 days."""
  expiringSoon: Int!
  """Estimated monthly recurring revenue (annual plans normalised to /12)."""
  estimatedMrr: Float!
  """Tenant count per plan."""
  byPlan: [PlanCount!]!
  """Subscription count per status (active/trial/suspended/expired)."""
  byStatus: [SubStatusCount!]!
}

"""Tenant count on a single plan."""
type PlanCount {
  planId: String!
  planName: String!
  tenants: Int!
  priceMonthly: Float!
}

"""Subscription count for a single status."""
type SubStatusCount {
  status: String!
  count: Int!
}

"""Quota utilisation and breaches across tenants."""
type PlatformQuotaStats {
  """Tenants currently over at least one quota."""
  overQuota: Int!
  """Aggregate student usage across tenants that have a student limit."""
  studentUsage: Int!
  """Aggregate student limit across tenants that have a student limit."""
  studentLimit: Int!
  """Aggregate employee usage across tenants that have an employee limit."""
  employeeUsage: Int!
  """Aggregate employee limit across tenants that have an employee limit."""
  employeeLimit: Int!
  """Tenants over quota with breach detail (top 8 by overage)."""
  breaches: [TenantQuotaBreach!]!
}

"""A single quota breach for a tenant."""
type TenantQuotaBreach {
  tenantId: String!
  tenantName: String!
  """Resource breached: students | employees."""
  resource: String!
  limit: Int!
  current: Int!
  overBy: Int!
}

extend type Query {
  """The saved brochure content as a JSON string for the current tenant, or null when nothing has been saved yet."""
  brochureContent: String
}

extend type Mutation {
  """Save the brochure content (JSON string) for the current tenant. Admin only."""
  updateBrochureContent(content: String!): String!
}

"""A person treated by the facility — the healthcare-industry counterpart of Student. Managed by staff; no login account."""
type Patient {
  """Unique identifier."""
  id: ID!
  """Medical Record Number, unique within the tenant."""
  mrn: String!
  """Lifetime Unique Health ID. Server-assigned on registration."""
  uhid: String
  """First name."""
  firstName: String!
  """Last name."""
  lastName: String
  """Gender."""
  gender: String
  """Date of birth (YYYY-MM-DD)."""
  dateOfBirth: String
  """Blood group."""
  bloodGroup: String
  """Contact phone."""
  phone: String
  """Contact email."""
  email: String
  """Street address."""
  address: String
  """City."""
  city: String
  """State."""
  state: String
  """Postal code."""
  pincode: String
  """Emergency contact name."""
  emergencyName: String
  """Emergency contact phone."""
  emergencyPhone: String
  """Known allergies (free text, surfaced on every encounter)."""
  allergies: String
  """Chronic conditions (free text)."""
  chronicConditions: String
  """Status: active | inactive | deceased."""
  status: String!
  """First registration timestamp (RFC3339)."""
  registeredAt: String
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

input CreatePatientInput {
  """Medical Record Number. Auto-generated when omitted."""
  mrn: String
  firstName: String!
  lastName: String
  gender: String
  dateOfBirth: String
  bloodGroup: String
  phone: String
  email: String
  address: String
  city: String
  state: String
  pincode: String
  emergencyName: String
  emergencyPhone: String
  allergies: String
  chronicConditions: String
}

input UpdatePatientInput {
  mrn: String
  firstName: String
  lastName: String
  gender: String
  dateOfBirth: String
  bloodGroup: String
  phone: String
  email: String
  address: String
  city: String
  state: String
  pincode: String
  emergencyName: String
  emergencyPhone: String
  allergies: String
  chronicConditions: String
  """Status: active | inactive | deceased."""
  status: String
}

"""A booked consultation slot between a patient and a clinician (an Employee)."""
type Appointment {
  """Unique identifier."""
  id: ID!
  """Patient UUID."""
  patientId: String!
  """Patient display name."""
  patientName: String!
  """Patient MRN."""
  patientMrn: String!
  """Clinician (Employee) UUID. Blank when the clinician left the organisation."""
  clinicianId: String!
  """Clinician display name."""
  clinicianName: String!
  """Department UUID, when scoped to one."""
  departmentId: String
  """Department name."""
  departmentName: String
  """Appointment date (YYYY-MM-DD)."""
  date: String!
  """Start time (HH:MM, 24h)."""
  startTime: String!
  """End time (HH:MM, 24h)."""
  endTime: String
  """Reason for visit."""
  reason: String
  """Internal notes."""
  notes: String
  """Who referred the patient (doctor, camp, or SELF). Printed on the OPD slip."""
  referredBy: String
  """Status: scheduled | completed | cancelled | no_show."""
  status: String!
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

input CreateAppointmentInput {
  patientId: String!
  clinicianId: String!
  departmentId: String
  """Appointment date (YYYY-MM-DD)."""
  date: String!
  """Start time (HH:MM, 24h)."""
  startTime: String!
  """End time (HH:MM, 24h)."""
  endTime: String
  reason: String
  notes: String
  """Who referred the patient (doctor, camp, or SELF)."""
  referredBy: String
}

input UpdateAppointmentInput {
  patientId: String
  clinicianId: String
  departmentId: String
  date: String
  startTime: String
  endTime: String
  reason: String
  notes: String
  """Who referred the patient (doctor, camp, or SELF)."""
  referredBy: String
  """Status: scheduled | completed | cancelled | no_show."""
  status: String
}

"""One clinical visit (OPD): complaint, findings, vitals, and prescription. May link back to the appointment that produced it."""
type Encounter {
  """Unique identifier."""
  id: ID!
  """Patient UUID."""
  patientId: String!
  """Patient display name."""
  patientName: String!
  """Patient MRN."""
  patientMrn: String!
  """Patient allergies, surfaced for safety."""
  patientAllergies: String
  """Clinician (Employee) UUID. Blank when the clinician left the organisation."""
  clinicianId: String!
  """Clinician display name."""
  clinicianName: String!
  """Linked appointment UUID; blank for walk-ins."""
  appointmentId: String
  """Per-visit Case Record number. Server-assigned on creation."""
  crNumber: String
  """Visit type: opd."""
  visitType: String!
  """Visit date (YYYY-MM-DD)."""
  visitDate: String!
  """Presenting complaint."""
  chiefComplaint: String
  """Clinician's diagnosis."""
  diagnosis: String
  """Vitals as a JSON object string (bp, pulse, temp_c, spo2, weight_kg)."""
  vitals: String
  """Prescription text."""
  prescription: String
  """Clinical notes."""
  notes: String
  """Follow-up date (YYYY-MM-DD)."""
  followUpDate: String
  """Status: open | closed."""
  status: String!
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

input CreateEncounterInput {
  patientId: String!
  clinicianId: String!
  """Linked appointment UUID; omit for walk-ins."""
  appointmentId: String
  """Visit type: opd (default) | ipd | emergency."""
  visitType: String
  """Visit date (YYYY-MM-DD). Defaults to today."""
  visitDate: String
  chiefComplaint: String
  diagnosis: String
  """Vitals as a JSON object string."""
  vitals: String
  prescription: String
  notes: String
  followUpDate: String
}

input UpdateEncounterInput {
  clinicianId: String
  visitDate: String
  chiefComplaint: String
  diagnosis: String
  vitals: String
  prescription: String
  notes: String
  followUpDate: String
  """Status: open | closed."""
  status: String
}

extend type Query {
  """List patients. All filters optional; search matches name, MRN, and phone. Supports offset pagination."""
  patients(
    """Full-text search on name, MRN, or phone."""
    search: String
    """Filter by status: active | inactive | deceased."""
    status: String
    """Max rows to return (default 50)."""
    limit: Int
    """Rows to skip for pagination."""
    offset: Int
  ): [Patient!]!
  """Total count of patients matching the same filters."""
  patientsCount(search: String, status: String): Int!
  """Fetch a single patient by ID."""
  patient(id: ID!): Patient
  """List appointments. All filters optional and combinable."""
  appointments(
    """Filter by date (YYYY-MM-DD)."""
    date: String
    """Filter by clinician (Employee) UUID."""
    clinicianId: String
    """Filter by patient UUID."""
    patientId: String
    """Filter by status: scheduled | completed | cancelled | no_show."""
    status: String
  ): [Appointment!]!
  """List encounters (clinical visits). All filters optional and combinable."""
  encounters(
    """Filter by patient UUID."""
    patientId: String
    """Filter by clinician (Employee) UUID."""
    clinicianId: String
    """Filter by visit date (YYYY-MM-DD)."""
    date: String
    """Filter by status: open | closed."""
    status: String
  ): [Encounter!]!
  """Fetch a single encounter by ID."""
  encounter(id: ID!): Encounter
}

extend type Mutation {
  """Register a new patient. MRN is auto-generated when omitted."""
  createPatient(input: CreatePatientInput!): Patient!
  """Update a patient's demographics, clinical flags, or status."""
  updatePatient(id: ID!, input: UpdatePatientInput!): Patient!
  """Delete a patient and all their appointments and encounters."""
  deletePatient(id: ID!): Boolean!
  """Book an appointment. Rejects double-booking the clinician for the same date and start time."""
  createAppointment(input: CreateAppointmentInput!): Appointment!
  """Update or reschedule an appointment (including status changes)."""
  updateAppointment(id: ID!, input: UpdateAppointmentInput!): Appointment!
  """Delete an appointment."""
  deleteAppointment(id: ID!): Boolean!
  """Record a clinical visit. Completing it later closes the encounter."""
  createEncounter(input: CreateEncounterInput!): Encounter!
  """Update an encounter's findings, vitals, prescription, or status."""
  updateEncounter(id: ID!, input: UpdateEncounterInput!): Encounter!
  """Delete an encounter."""
  deleteEncounter(id: ID!): Boolean!
}

"""A priced catalog entry used to bill clinical services (consultation, procedure, X-ray, …)."""
type BillableService {
  """Unique identifier."""
  id: ID!
  """Short code, unique within the tenant."""
  code: String!
  """Display name."""
  name: String!
  """Category: consultation | procedure | lab | radiology | other."""
  category: String!
  """Price per unit."""
  unitPrice: Float!
  """Whether the service is offered (shown when billing)."""
  active: Boolean!
}

input CreateBillableServiceInput {
  code: String!
  name: String!
  """Category: consultation | procedure | lab | radiology | other."""
  category: String
  unitPrice: Float!
}

input UpdateBillableServiceInput {
  code: String
  name: String
  category: String
  unitPrice: Float
  active: Boolean
}

"""One charged line on an invoice. Description and price are frozen at billing time."""
type InvoiceItem {
  """Unique identifier."""
  id: ID!
  """Source catalog service UUID; blank for free-text lines."""
  serviceId: String
  """Line description."""
  description: String!
  """Quantity."""
  qty: Float!
  """Price per unit at billing time."""
  unitPrice: Float!
  """Line amount (qty × unitPrice)."""
  amount: Float!
}

input InvoiceItemInput {
  """Catalog service UUID; omit for a free-text line."""
  serviceId: String
  """Line description. Defaults to the service name when serviceId is given."""
  description: String
  """Quantity (default 1)."""
  qty: Float
  """Price per unit. Defaults to the service's catalog price."""
  unitPrice: Float
}

"""Money received against an invoice."""
type InvoicePayment {
  """Unique identifier."""
  id: ID!
  """Invoice UUID."""
  invoiceId: String!
  """Amount received."""
  amount: Float!
  """Mode: cash | card | upi | online | cheque."""
  mode: String!
  """External reference (transaction id, cheque no)."""
  reference: String
  """When the money was received (RFC3339)."""
  paidAt: String
}

input RecordInvoicePaymentInput {
  invoiceId: String!
  amount: Float!
  """Mode: cash | card | upi | online | cheque (default cash)."""
  mode: String
  reference: String
}

"""A patient bill: line items, discount, payments, and a derived status."""
type Invoice {
  """Unique identifier."""
  id: ID!
  """Human-facing number, unique per tenant (INV-00001)."""
  invoiceNo: String!
  """Patient UUID."""
  patientId: String!
  """Patient display name."""
  patientName: String!
  """Patient MRN."""
  patientMrn: String!
  """Patient's lifetime UHID, surfaced for printing on the invoice."""
  patientUhid: String
  """Linked encounter UUID; blank when billed directly."""
  encounterId: String
  """The linked encounter's Case Record number, when billed from a visit."""
  encounterCrNumber: String
  """Invoice date (YYYY-MM-DD)."""
  date: String!
  """Charged lines."""
  items: [InvoiceItem!]!
  """Sum of line amounts."""
  subtotal: Float!
  """Flat discount applied to the subtotal."""
  discount: Float!
  """Amount owed (subtotal − discount)."""
  total: Float!
  """Total received so far."""
  amountPaid: Float!
  """Payments received."""
  payments: [InvoicePayment!]!
  """Status: unpaid | partially_paid | paid | cancelled."""
  status: String!
  """Notes."""
  notes: String
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

input CreateInvoiceInput {
  patientId: String!
  """Linked encounter UUID; omit when billing directly."""
  encounterId: String
  """Invoice date (YYYY-MM-DD). Defaults to today."""
  date: String
  """Flat discount off the subtotal."""
  discount: Float
  notes: String
  items: [InvoiceItemInput!]!
}

"""A pharmacy catalog entry with live stock."""
type Drug {
  """Unique identifier."""
  id: ID!
  """Brand/display name, unique within the tenant."""
  name: String!
  """Generic (INN) name."""
  genericName: String
  """Form: tablet | capsule | syrup | injection | ointment | drops | other."""
  form: String!
  """Strength, e.g. 500mg."""
  strength: String
  """What one stock count means (tablet, bottle, vial)."""
  unit: String!
  """Selling price per unit."""
  unitPrice: Float!
  """Units currently in stock."""
  stockQty: Float!
  """Stock level that should trigger a re-order."""
  reorderLevel: Float!
  """Whether the drug is dispensable."""
  active: Boolean!
}

input CreateDrugInput {
  name: String!
  genericName: String
  """Form: tablet | capsule | syrup | injection | ointment | drops | other."""
  form: String
  strength: String
  unit: String
  unitPrice: Float!
  """Opening stock (default 0)."""
  stockQty: Float
  reorderLevel: Float
  """Optional batch number. When set, the opening stock is recorded as an initial DrugBatch (enables expiry tracking + FEFO)."""
  batchNo: String
  """Optional batch expiry date (YYYY-MM-DD). Only used when batchNo is set."""
  expiryDate: String
}

"""Log a received lot for a drug, with its own expiry and remaining quantity."""
input CreateDrugBatchInput {
  drugId: ID!
  batchNo: String!
  """Expiry date (YYYY-MM-DD). Blank for non-expiring stock."""
  expiryDate: String
  qty: Float!
  unitCost: Float
}

input UpdateDrugInput {
  name: String
  genericName: String
  form: String
  strength: String
  unit: String
  unitPrice: Float
  reorderLevel: Float
  active: Boolean
}

"""One drug line handed over on a dispense; name/price frozen at hand-over."""
type DispenseItem {
  """Unique identifier."""
  id: ID!
  """Drug UUID."""
  drugId: String!
  """Drug name at hand-over."""
  drugName: String!
  """Units dispensed."""
  qty: Float!
  """Price per unit at hand-over."""
  unitPrice: Float!
  """Line amount."""
  amount: Float!
}

input DispenseItemInput {
  drugId: String!
  qty: Float!
}

"""One hand-over of drugs to a patient. Creating it decrements stock."""
type Dispense {
  """Unique identifier."""
  id: ID!
  """Patient UUID."""
  patientId: String!
  """Patient display name."""
  patientName: String!
  """Patient MRN."""
  patientMrn: String!
  """Linked encounter UUID; blank for counter sales to registered patients."""
  encounterId: String
  """Dispense date (YYYY-MM-DD)."""
  date: String!
  """Dispensed lines."""
  items: [DispenseItem!]!
  """Total value of the dispense."""
  totalAmount: Float!
  """Notes."""
  notes: String
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

input CreateDispenseInput {
  patientId: String!
  """Linked encounter UUID; omit for direct dispensing."""
  encounterId: String
  """Dispense date (YYYY-MM-DD). Defaults to today."""
  date: String
  notes: String
  items: [DispenseItemInput!]!
}

"""One weekly availability window for a clinician. Booking validates against these when any exist."""
type ClinicianSchedule {
  """Unique identifier."""
  id: ID!
  """Clinician (Employee) UUID."""
  clinicianId: String!
  """Clinician display name."""
  clinicianName: String!
  """Day of week: 0 = Sunday … 6 = Saturday."""
  dayOfWeek: Int!
  """Window start (HH:MM, 24h)."""
  startTime: String!
  """Window end (HH:MM, 24h)."""
  endTime: String!
  """Default consultation length in minutes."""
  slotMinutes: Int!
  """Whether the window is in effect."""
  active: Boolean!
}

input CreateClinicianScheduleInput {
  clinicianId: String!
  """Day of week: 0 = Sunday … 6 = Saturday."""
  dayOfWeek: Int!
  startTime: String!
  endTime: String!
  """Default consultation length in minutes (default 15)."""
  slotMinutes: Int
}

input UpdateClinicianScheduleInput {
  dayOfWeek: Int
  startTime: String
  endTime: String
  slotMinutes: Int
  active: Boolean
}

extend type Query {
  """List billable services. Active only unless includeInactive is true."""
  billableServices(includeInactive: Boolean): [BillableService!]!
  """List invoices. All filters optional and combinable."""
  invoices(
    """Filter by patient UUID."""
    patientId: String
    """Filter by status: unpaid | partially_paid | paid | cancelled."""
    status: String
    """Filter by invoice date (YYYY-MM-DD)."""
    date: String
  ): [Invoice!]!
  """Fetch a single invoice with items and payments."""
  invoice(id: ID!): Invoice
  """List pharmacy drugs. Active only unless includeInactive is true; search matches name/generic."""
  drugs(search: String, includeInactive: Boolean): [Drug!]!
  """List dispenses. All filters optional."""
  dispenses(patientId: String, date: String): [Dispense!]!
  """List clinician availability windows, optionally for one clinician."""
  clinicianSchedules(clinicianId: String): [ClinicianSchedule!]!
}

extend type Mutation {
  """Add a billable service to the catalog."""
  createBillableService(input: CreateBillableServiceInput!): BillableService!
  """Update a billable service."""
  updateBillableService(id: ID!, input: UpdateBillableServiceInput!): BillableService!
  """Delete a billable service (invoice lines keep their frozen copy)."""
  deleteBillableService(id: ID!): Boolean!
  """Create an invoice for a patient from catalog and/or free-text lines."""
  createInvoice(input: CreateInvoiceInput!): Invoice!
  """Cancel an invoice (blocked once any payment is recorded)."""
  cancelInvoice(id: ID!): Invoice!
  """Record a payment against an invoice. Rejects overpayment."""
  recordInvoicePayment(input: RecordInvoicePaymentInput!): Invoice!
  """Add a drug to the pharmacy catalog."""
  createDrug(input: CreateDrugInput!): Drug!
  """Update a drug's details (stock changes go through adjustDrugStock)."""
  updateDrug(id: ID!, input: UpdateDrugInput!): Drug!
  """Delete a drug (dispense lines keep their frozen copy)."""
  deleteDrug(id: ID!): Boolean!
  """Adjust a drug's stock by a delta (positive = restock, negative = correction). Stock never goes below zero."""
  adjustDrugStock(id: ID!, delta: Float!): Drug!
  """Log a received batch/lot for a drug (batch no + expiry + qty); bumps the drug's stock. Powers expiry tracking and FEFO dispensing without a full purchase order."""
  createDrugBatch(input: CreateDrugBatchInput!): DrugBatch!
  """Dispense drugs to a patient; decrements stock atomically and rejects insufficient stock."""
  createDispense(input: CreateDispenseInput!): Dispense!
  """Add a weekly availability window for a clinician."""
  createClinicianSchedule(input: CreateClinicianScheduleInput!): ClinicianSchedule!
  """Update an availability window."""
  updateClinicianSchedule(id: ID!, input: UpdateClinicianScheduleInput!): ClinicianSchedule!
  """Delete an availability window."""
  deleteClinicianSchedule(id: ID!): Boolean!
}

# ═══════════════════════════════════════════════════════════════════════════
# Phase 3 — Diagnostics & inpatient (healthcare industry)
# Laboratory (LIS), Radiology, IPD/ADT, Ward/Bed management.
# ═══════════════════════════════════════════════════════════════════════════

# ── Laboratory (LIS) ─────────────────────────────────────────────────────────
"""A catalog lab test the lab can order and result."""
type LabTest {
  id: ID!
  code: String!
  name: String!
  category: String
  """Order-set grouping (CBC, LFT, KFT, …); independent of category."""
  panel: String
  """Assay/technique used, e.g. ELISA."""
  method: String
  """Sample type: blood | urine | stool | swab | other."""
  sampleType: String!
  unit: String
  """Numeric reference bounds; when both are 0 the test is qualitative."""
  refLow: Float!
  refHigh: Float!
  refText: String
  price: Float!
  active: Boolean!
  createdAt: String
}

input CreateLabTestInput {
  code: String!
  name: String!
  category: String
  panel: String
  method: String
  sampleType: String
  unit: String
  refLow: Float
  refHigh: Float
  refText: String
  price: Float
}

input UpdateLabTestInput {
  code: String
  name: String
  category: String
  panel: String
  method: String
  sampleType: String
  unit: String
  refLow: Float
  refHigh: Float
  refText: String
  price: Float
  active: Boolean
}

"""One test line on a lab order, with its frozen catalog snapshot and result."""
type LabOrderItem {
  id: ID!
  testId: String!
  testCode: String!
  testName: String!
  unit: String
  refLow: Float!
  refHigh: Float!
  refText: String
  price: Float!
  resultValue: String
  """Flag: normal | high | low | abnormal (blank until resulted)."""
  flag: String
  resultedAt: String
}

"""A lab order: one or more tests for a patient, optionally tied to an encounter."""
type LabOrder {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  encounterId: String
  orderedById: String
  orderedByName: String
  orderDate: String!
  """Status: ordered | collected | resulted | cancelled."""
  status: String!
  notes: String
  items: [LabOrderItem!]!
  totalPrice: Float!
  createdAt: String
}

input LabOrderItemInput {
  testId: String!
}

input CreateLabOrderInput {
  patientId: String!
  encounterId: String
  orderedById: String
  orderDate: String
  notes: String
  tests: [LabOrderItemInput!]!
}

input LabResultInput {
  itemId: ID!
  resultValue: String!
}

# ── Radiology ────────────────────────────────────────────────────────────────
"""A catalog imaging study."""
type RadiologyStudy {
  id: ID!
  code: String!
  name: String!
  """Modality: xray | ct | mri | ultrasound | mammography | other."""
  modality: String!
  bodyPart: String
  price: Float!
  active: Boolean!
  createdAt: String
}

input CreateRadiologyStudyInput {
  code: String!
  name: String!
  modality: String
  bodyPart: String
  price: Float
}

input UpdateRadiologyStudyInput {
  code: String
  name: String
  modality: String
  bodyPart: String
  price: Float
  active: Boolean
}

"""An imaging order with its (later) report."""
type RadiologyOrder {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  encounterId: String
  orderedById: String
  orderedByName: String
  studyId: String!
  studyCode: String!
  studyName: String!
  modality: String!
  bodyPart: String
  price: Float!
  orderDate: String!
  """Status: ordered | scheduled | completed | reported | cancelled."""
  status: String!
  notes: String
  findings: String
  impression: String
  reportedById: String
  reportedByName: String
  reportedAt: String
  createdAt: String
}

input CreateRadiologyOrderInput {
  patientId: String!
  encounterId: String
  orderedById: String
  studyId: String!
  orderDate: String
  notes: String
}

input RadiologyReportInput {
  findings: String!
  impression: String!
  reportedById: String
}

# ── Ward / Bed ───────────────────────────────────────────────────────────────
"""A bed within a ward."""
type Bed {
  id: ID!
  wardId: String!
  bedNumber: String!
  bay: String
  """Status: available | occupied | maintenance."""
  status: String!
  dailyCharge: Float!
  """Current occupant (when occupied)."""
  patientId: String
  patientName: String
  admissionId: String
}

"""A nursing unit that holds beds (blocks→wards)."""
type Ward {
  id: ID!
  code: String!
  name: String!
  """Type: general | icu | hdu | maternity | pediatric | private | isolation."""
  wardType: String!
  """Occupant policy: any | male | female."""
  gender: String!
  floor: String
  active: Boolean!
  beds: [Bed!]!
  bedCount: Int!
  occupiedCount: Int!
  createdAt: String
}

input CreateWardInput {
  code: String!
  name: String!
  wardType: String
  gender: String
  floor: String
}

input UpdateWardInput {
  code: String
  name: String
  wardType: String
  gender: String
  floor: String
  active: Boolean
}

input CreateBedInput {
  wardId: String!
  bedNumber: String!
  bay: String
  dailyCharge: Float
}

input UpdateBedInput {
  bedNumber: String
  bay: String
  dailyCharge: Float
  """Status: available | maintenance (occupied is set by admissions)."""
  status: String
}

# ── Admission / ADT ──────────────────────────────────────────────────────────
"""One ward/bed move within an admission (the T in ADT)."""
type BedTransfer {
  id: ID!
  fromBedId: String
  toBedId: String
  fromBedNumber: String
  toBedNumber: String
  fromWardName: String
  toWardName: String
  transferDate: String
  reason: String
}

"""An inpatient admission: patient on a bed, with the discharge summary."""
type Admission {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  encounterId: String
  clinicianId: String
  clinicianName: String
  wardId: String
  wardName: String
  bedId: String
  bedNumber: String
  admissionDate: String!
  reason: String
  """Status: admitted | discharged."""
  status: String!
  dischargeDate: String
  dischargeDiagnosis: String
  treatmentGiven: String
  conditionOnDischarge: String
  followUpInstructions: String
  transfers: [BedTransfer!]!
  createdAt: String
}

input CreateAdmissionInput {
  patientId: String!
  clinicianId: String
  wardId: String!
  bedId: String!
  admissionDate: String
  reason: String
  """Open a linked IPD encounter for this admission when true."""
  openEncounter: Boolean
}

input TransferAdmissionInput {
  admissionId: ID!
  toBedId: String!
  transferDate: String
  reason: String
}

input DischargeAdmissionInput {
  admissionId: ID!
  dischargeDate: String
  dischargeDiagnosis: String
  treatmentGiven: String
  conditionOnDischarge: String
  followUpInstructions: String
}

extend type Query {
  # Laboratory
  """List lab tests in the catalog. search matches code/name; includeInactive shows disabled tests."""
  labTests(search: String, includeInactive: Boolean): [LabTest!]!
  """List lab orders. All filters optional and combinable."""
  labOrders(patientId: String, encounterId: String, status: String, date: String): [LabOrder!]!
  """Fetch a single lab order by ID."""
  labOrder(id: ID!): LabOrder
  # Radiology
  radiologyStudies(search: String, includeInactive: Boolean): [RadiologyStudy!]!
  radiologyOrders(patientId: String, encounterId: String, status: String, date: String): [RadiologyOrder!]!
  radiologyOrder(id: ID!): RadiologyOrder
  # Ward / Bed
  wards(includeInactive: Boolean): [Ward!]!
  ward(id: ID!): Ward
  """List beds, optionally filtered to one ward or one status."""
  beds(wardId: String, status: String): [Bed!]!
  # Admissions
  """List admissions. Defaults to currently-admitted; pass status for history."""
  admissions(patientId: String, wardId: String, status: String): [Admission!]!
  admission(id: ID!): Admission
}

extend type Mutation {
  # Laboratory
  createLabTest(input: CreateLabTestInput!): LabTest!
  updateLabTest(id: ID!, input: UpdateLabTestInput!): LabTest!
  deleteLabTest(id: ID!): Boolean!
  createLabOrder(input: CreateLabOrderInput!): LabOrder!
  """Enter/update results for one or more lines; auto-flags and advances status."""
  enterLabResults(orderId: ID!, results: [LabResultInput!]!): LabOrder!
  cancelLabOrder(id: ID!): LabOrder!
  # Radiology
  createRadiologyStudy(input: CreateRadiologyStudyInput!): RadiologyStudy!
  updateRadiologyStudy(id: ID!, input: UpdateRadiologyStudyInput!): RadiologyStudy!
  deleteRadiologyStudy(id: ID!): Boolean!
  createRadiologyOrder(input: CreateRadiologyOrderInput!): RadiologyOrder!
  """Set an order's workflow status: scheduled | completed | cancelled."""
  setRadiologyOrderStatus(id: ID!, status: String!): RadiologyOrder!
  """File findings + impression; flips the order to reported."""
  reportRadiologyOrder(id: ID!, input: RadiologyReportInput!): RadiologyOrder!
  # Ward / Bed
  createWard(input: CreateWardInput!): Ward!
  updateWard(id: ID!, input: UpdateWardInput!): Ward!
  deleteWard(id: ID!): Boolean!
  createBed(input: CreateBedInput!): Bed!
  updateBed(id: ID!, input: UpdateBedInput!): Bed!
  deleteBed(id: ID!): Boolean!
  # Admissions / ADT
  createAdmission(input: CreateAdmissionInput!): Admission!
  transferAdmission(input: TransferAdmissionInput!): Admission!
  dischargeAdmission(input: DischargeAdmissionInput!): Admission!
}

# ═══════════════════════════════════════════════════════════════════════════
# Phase 4 — Operations around the core (healthcare industry)
# Nursing station (MAR + vitals), Insurance/TPA claims, Inventory & stores,
# OT scheduling, Emergency/Triage.
# ═══════════════════════════════════════════════════════════════════════════

# ── Nursing station ──────────────────────────────────────────────────────────
"""A set of vitals charted for an admitted patient."""
type VitalsRecord {
  id: ID!
  admissionId: String!
  patientId: String!
  recordedById: String
  recordedByName: String
  recordedAt: String!
  tempC: Float!
  pulse: Int!
  respRate: Int!
  bpSystolic: Int!
  bpDiastolic: Int!
  spo2: Int!
  painScore: Int!
  notes: String
}

input RecordVitalsInput {
  admissionId: String!
  recordedById: String
  recordedAt: String
  tempC: Float
  pulse: Int
  respRate: Int
  bpSystolic: Int
  bpDiastolic: Int
  spo2: Int
  painScore: Int
  notes: String
}

"""One recorded dose event against a medication order."""
type MedicationAdministration {
  id: ID!
  administeredById: String
  administeredByName: String
  administeredAt: String!
  status: String!
  notes: String
}

"""A prescribed drug on an admitted patient's MAR."""
type MedicationOrder {
  id: ID!
  admissionId: String!
  patientId: String!
  drugId: String
  drugName: String!
  dose: String
  route: String
  frequency: String
  orderedById: String
  orderedByName: String
  startDate: String
  endDate: String
  status: String!
  notes: String
  administrations: [MedicationAdministration!]!
  createdAt: String
}

input CreateMedicationOrderInput {
  admissionId: String!
  drugId: String
  drugName: String!
  dose: String
  route: String
  frequency: String
  orderedById: String
  startDate: String
  endDate: String
  notes: String
}

input RecordAdministrationInput {
  medicationOrderId: ID!
  administeredById: String
  administeredAt: String
  """Status: given | held | refused."""
  status: String
  notes: String
}

# ── Insurance / TPA claims ───────────────────────────────────────────────────
"""An insurer or TPA the hospital bills claims to."""
type InsurancePayer {
  id: ID!
  code: String!
  name: String!
  payerType: String!
  contactName: String
  phone: String
  email: String
  active: Boolean!
}

input CreateInsurancePayerInput {
  code: String!
  name: String!
  payerType: String
  contactName: String
  phone: String
  email: String
}

input UpdateInsurancePayerInput {
  code: String
  name: String
  payerType: String
  contactName: String
  phone: String
  email: String
  active: Boolean
}

"""A reimbursement claim for a patient's care."""
type InsuranceClaim {
  id: ID!
  claimNumber: String!
  patientId: String!
  patientName: String!
  patientMrn: String!
  admissionId: String
  invoiceId: String
  payerId: String
  payerName: String
  policyNumber: String
  diagnosis: String
  claimAmount: Float!
  approvedAmount: Float!
  """Status: draft | submitted | under_review | approved | rejected | settled."""
  status: String!
  notes: String
  submittedAt: String
  settledAt: String
  createdAt: String
}

input CreateInsuranceClaimInput {
  patientId: String!
  payerId: String!
  admissionId: String
  invoiceId: String
  policyNumber: String
  diagnosis: String
  claimAmount: Float
  notes: String
}

input UpdateInsuranceClaimInput {
  payerId: String
  policyNumber: String
  diagnosis: String
  claimAmount: Float
  approvedAmount: Float
  notes: String
}

# ── Inventory & stores ───────────────────────────────────────────────────────
"""A stocked line in the central store."""
type InventoryItem {
  id: ID!
  code: String!
  name: String!
  category: String!
  unit: String!
  stockQty: Float!
  reorderLevel: Float!
  unitCost: Float!
  linkedDrugId: String
  linkedDrugName: String
  active: Boolean!
  createdAt: String
}

input CreateInventoryItemInput {
  code: String!
  name: String!
  category: String
  unit: String
  reorderLevel: Float
  unitCost: Float
  openingStock: Float
  linkedDrugId: String
}

input UpdateInventoryItemInput {
  code: String
  name: String
  category: String
  unit: String
  reorderLevel: Float
  unitCost: Float
  linkedDrugId: String
  active: Boolean
}

"""One movement of an inventory item (signed qty)."""
type StockTransaction {
  id: ID!
  itemId: String!
  itemName: String!
  kind: String!
  qty: Float!
  reason: String
  reference: String
  byName: String
  date: String
  createdAt: String
}

# ── OT scheduling ────────────────────────────────────────────────────────────
type OperationTheatre {
  id: ID!
  code: String!
  name: String!
  location: String
  active: Boolean!
}

input CreateOperationTheatreInput {
  code: String!
  name: String!
  location: String
}

input UpdateOperationTheatreInput {
  code: String
  name: String
  location: String
  active: Boolean
}

"""A theatre booking for a patient's procedure."""
type SurgerySchedule {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  theatreId: String!
  theatreName: String!
  surgeonId: String
  surgeonName: String
  procedureName: String!
  anesthesiaType: String
  scheduledDate: String!
  startTime: String!
  endTime: String!
  status: String!
  notes: String
  createdAt: String
}

input ScheduleSurgeryInput {
  patientId: String!
  theatreId: String!
  surgeonId: String
  procedureName: String!
  anesthesiaType: String
  scheduledDate: String!
  startTime: String!
  endTime: String!
  notes: String
}

# ── Emergency / Triage ───────────────────────────────────────────────────────
"""An emergency-department presentation, scored by acuity."""
type TriageCase {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  arrivalTime: String!
  chiefComplaint: String
  triageLevel: Int!
  vitals: String
  assignedClinicianId: String
  assignedClinicianName: String
  status: String!
  disposition: String
  notes: String
  createdAt: String
}

input CreateTriageCaseInput {
  patientId: String!
  chiefComplaint: String
  triageLevel: Int
  vitals: String
  assignedClinicianId: String
  notes: String
}

input UpdateTriageCaseInput {
  triageLevel: Int
  vitals: String
  assignedClinicianId: String
  """Status: waiting | in_treatment | disposed."""
  status: String
  """Disposition (set when disposed): admitted | discharged | referred | lwbs | deceased."""
  disposition: String
  notes: String
}

extend type Query {
  # Nursing
  vitalsRecords(admissionId: String!): [VitalsRecord!]!
  medicationOrders(admissionId: String!, includeDiscontinued: Boolean): [MedicationOrder!]!
  # Claims
  insurancePayers(includeInactive: Boolean): [InsurancePayer!]!
  insuranceClaims(patientId: String, payerId: String, status: String): [InsuranceClaim!]!
  insuranceClaim(id: ID!): InsuranceClaim
  # Inventory
  inventoryItems(search: String, category: String, includeInactive: Boolean): [InventoryItem!]!
  stockTransactions(itemId: String!): [StockTransaction!]!
  # OT
  operationTheatres(includeInactive: Boolean): [OperationTheatre!]!
  surgeries(date: String, theatreId: String, status: String): [SurgerySchedule!]!
  # Triage
  triageCases(status: String, date: String): [TriageCase!]!
}

extend type Mutation {
  # Nursing
  recordVitals(input: RecordVitalsInput!): VitalsRecord!
  createMedicationOrder(input: CreateMedicationOrderInput!): MedicationOrder!
  discontinueMedicationOrder(id: ID!): MedicationOrder!
  recordMedicationAdministration(input: RecordAdministrationInput!): MedicationOrder!
  # Claims (submit-for-approval is REST; approval callback drives status)
  createInsurancePayer(input: CreateInsurancePayerInput!): InsurancePayer!
  updateInsurancePayer(id: ID!, input: UpdateInsurancePayerInput!): InsurancePayer!
  deleteInsurancePayer(id: ID!): Boolean!
  createInsuranceClaim(input: CreateInsuranceClaimInput!): InsuranceClaim!
  updateInsuranceClaim(id: ID!, input: UpdateInsuranceClaimInput!): InsuranceClaim!
  deleteInsuranceClaim(id: ID!): Boolean!
  """Mark an approved claim settled (final step after reimbursement)."""
  settleInsuranceClaim(id: ID!, approvedAmount: Float): InsuranceClaim!
  # Inventory
  createInventoryItem(input: CreateInventoryItemInput!): InventoryItem!
  updateInventoryItem(id: ID!, input: UpdateInventoryItemInput!): InventoryItem!
  deleteInventoryItem(id: ID!): Boolean!
  """Receive stock into the store (positive qty)."""
  receiveStock(itemId: ID!, qty: Float!, reason: String): InventoryItem!
  """Adjust stock by a signed delta (correction/consumption)."""
  adjustInventoryStock(itemId: ID!, delta: Float!, reason: String): InventoryItem!
  """Issue stock from the store into the linked pharmacy drug (atomic)."""
  issueToPharmacy(itemId: ID!, qty: Float!): InventoryItem!
  # OT
  createOperationTheatre(input: CreateOperationTheatreInput!): OperationTheatre!
  updateOperationTheatre(id: ID!, input: UpdateOperationTheatreInput!): OperationTheatre!
  deleteOperationTheatre(id: ID!): Boolean!
  scheduleSurgery(input: ScheduleSurgeryInput!): SurgerySchedule!
  setSurgeryStatus(id: ID!, status: String!): SurgerySchedule!
  cancelSurgery(id: ID!): SurgerySchedule!
  # Triage
  createTriageCase(input: CreateTriageCaseInput!): TriageCase!
  updateTriageCase(id: ID!, input: UpdateTriageCaseInput!): TriageCase!
}

# ═══════════════════════════════════════════════════════════════════════════
# Phase 5 — Extended (healthcare industry)
# Blood bank, ambulance, dietary/kitchen, telemedicine, referrals, audit trail,
# and the patient self-service portal.
# ═══════════════════════════════════════════════════════════════════════════

# ── Blood bank ───────────────────────────────────────────────────────────────
type BloodUnit {
  id: ID!
  bagNumber: String!
  bloodGroup: String!
  component: String!
  volumeMl: Int!
  donorName: String
  collectedDate: String
  expiryDate: String
  status: String!
  issuedToId: String
  issuedToName: String
  issuedDate: String
  createdAt: String
}

input CreateBloodUnitInput {
  bagNumber: String!
  bloodGroup: String!
  component: String
  volumeMl: Int
  donorName: String
  collectedDate: String
  expiryDate: String
}

type BloodRequest {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  bloodGroup: String!
  component: String!
  unitsRequired: Int!
  requestedByName: String
  requestDate: String
  status: String!
  notes: String
  createdAt: String
}

input CreateBloodRequestInput {
  patientId: String!
  bloodGroup: String!
  component: String
  unitsRequired: Int
  requestedById: String
  notes: String
}

# ── Ambulance ────────────────────────────────────────────────────────────────
type Ambulance {
  id: ID!
  code: String!
  registration: String
  vehicleType: String!
  driverName: String
  driverPhone: String
  status: String!
  active: Boolean!
}

input CreateAmbulanceInput {
  code: String!
  registration: String
  vehicleType: String
  driverName: String
  driverPhone: String
}

input UpdateAmbulanceInput {
  code: String
  registration: String
  vehicleType: String
  driverName: String
  driverPhone: String
  status: String
  active: Boolean
}

type AmbulanceTrip {
  id: ID!
  ambulanceId: String!
  ambulanceCode: String!
  patientId: String
  patientName: String
  tripType: String!
  origin: String
  destination: String
  dispatchTime: String!
  returnTime: String
  status: String!
  notes: String
  createdAt: String
}

input DispatchAmbulanceInput {
  ambulanceId: String!
  patientId: String
  tripType: String
  origin: String
  destination: String
  notes: String
}

# ── Dietary / kitchen ────────────────────────────────────────────────────────
type MealServing {
  id: ID!
  mealType: String!
  servedAt: String!
  status: String!
  notes: String
}

type DietPlan {
  id: ID!
  admissionId: String!
  patientId: String!
  dietType: String!
  calories: Int!
  restrictions: String
  notes: String
  status: String!
  servings: [MealServing!]!
  createdAt: String
}

input CreateDietPlanInput {
  admissionId: String!
  dietType: String
  calories: Int
  restrictions: String
  notes: String
}

input UpdateDietPlanInput {
  dietType: String
  calories: Int
  restrictions: String
  notes: String
}

input RecordMealServingInput {
  dietPlanId: ID!
  mealType: String!
  status: String
  notes: String
}

# ── Telemedicine ─────────────────────────────────────────────────────────────
type TeleConsult {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  clinicianId: String
  clinicianName: String
  scheduledAt: String!
  meetingLink: String
  status: String!
  reason: String
  notes: String
  createdAt: String
}

input ScheduleTeleConsultInput {
  patientId: String!
  clinicianId: String
  scheduledAt: String!
  meetingLink: String
  reason: String
}

input UpdateTeleConsultInput {
  scheduledAt: String
  meetingLink: String
  status: String
  notes: String
}

# ── Referrals ────────────────────────────────────────────────────────────────
type Referral {
  id: ID!
  patientId: String!
  patientName: String!
  patientMrn: String!
  fromClinicianId: String
  fromClinicianName: String
  referredTo: String!
  specialty: String
  reason: String
  urgency: String!
  referralDate: String
  status: String!
  notes: String
  """Commission type: none | flat | percent."""
  commissionType: String!
  """Amount (flat) or percent 0-100 (percent)."""
  commissionValue: Float!
  """Billable amount the percent applies to (percent commissions only)."""
  commissionBase: Float!
  """Computed commission, frozen at settlement."""
  commissionAmount: Float!
  """Payee type: doctor | centre."""
  payeeType: String
  """Free-text external payee name."""
  payeeName: String
  """Optional internal doctor (Employee) UUID."""
  payeeEmployeeId: String
  payeeEmployeeName: String
  """Settlement status: pending | settled."""
  settlementStatus: String!
  """Settlement date (YYYY-MM-DD), once settled."""
  settledOn: String
  createdAt: String
}

input CreateReferralInput {
  patientId: String!
  fromClinicianId: String
  referredTo: String!
  specialty: String
  reason: String
  urgency: String
  notes: String
}

input SetReferralCommissionInput {
  """Commission type: none | flat | percent."""
  commissionType: String!
  """Amount (flat) or percent 0-100 (percent). Ignored when type is none."""
  commissionValue: Float
  """Billable amount the percent applies to. Required when type is percent."""
  commissionBase: Float
  """Payee type: doctor | centre."""
  payeeType: String
  """Free-text external payee name (when not an internal doctor)."""
  payeeName: String
  """Optional internal doctor (Employee) UUID."""
  payeeEmployeeId: String
}

# ── Audit trail ──────────────────────────────────────────────────────────────
type AuditLog {
  id: ID!
  actorId: String
  actorName: String
  actorRole: String
  action: String!
  module: String
  operation: String
  entityId: String
  detail: String
  ip: String
  createdAt: String!
}

# ── Patient portal (role-locked to patient) ──────────────────────────────────
"""A patient's own dashboard summary counts."""
type PatientPortalSummary {
  upcomingAppointments: Int!
  visits: Int!
  labOrders: Int!
  activeReferrals: Int!
}

extend type Query {
  # Blood bank
  bloodUnits(bloodGroup: String, status: String, component: String): [BloodUnit!]!
  bloodRequests(status: String): [BloodRequest!]!
  # Ambulance
  ambulances(includeInactive: Boolean): [Ambulance!]!
  ambulanceTrips(status: String, date: String): [AmbulanceTrip!]!
  # Dietary
  dietPlans(admissionId: String!, includeDiscontinued: Boolean): [DietPlan!]!
  # Telemedicine
  teleConsults(status: String, date: String): [TeleConsult!]!
  # Referrals
  referrals(status: String, settlementStatus: String): [Referral!]!
  # Audit
  auditLogs(action: String, module: String, actorId: String, limit: Int): [AuditLog!]!
  # Patient portal (scoped to the logged-in patient)
  myPatientProfile: Patient
  myPatientSummary: PatientPortalSummary!
  myPatientAppointments: [Appointment!]!
  myPatientVisits: [Encounter!]!
  myPatientLabOrders: [LabOrder!]!
  myPatientRadiologyOrders: [RadiologyOrder!]!
  myPatientReferrals: [Referral!]!
  myPatientTeleConsults: [TeleConsult!]!
}

extend type Mutation {
  # Blood bank
  addBloodUnit(input: CreateBloodUnitInput!): BloodUnit!
  updateBloodUnitStatus(id: ID!, status: String!): BloodUnit!
  issueBloodUnit(id: ID!, patientId: String!): BloodUnit!
  deleteBloodUnit(id: ID!): Boolean!
  createBloodRequest(input: CreateBloodRequestInput!): BloodRequest!
  fulfillBloodRequest(id: ID!): BloodRequest!
  cancelBloodRequest(id: ID!): BloodRequest!
  # Ambulance
  createAmbulance(input: CreateAmbulanceInput!): Ambulance!
  updateAmbulance(id: ID!, input: UpdateAmbulanceInput!): Ambulance!
  deleteAmbulance(id: ID!): Boolean!
  dispatchAmbulance(input: DispatchAmbulanceInput!): AmbulanceTrip!
  completeAmbulanceTrip(id: ID!): AmbulanceTrip!
  cancelAmbulanceTrip(id: ID!): AmbulanceTrip!
  # Dietary
  createDietPlan(input: CreateDietPlanInput!): DietPlan!
  updateDietPlan(id: ID!, input: UpdateDietPlanInput!): DietPlan!
  discontinueDietPlan(id: ID!): DietPlan!
  recordMealServing(input: RecordMealServingInput!): DietPlan!
  # Telemedicine
  scheduleTeleConsult(input: ScheduleTeleConsultInput!): TeleConsult!
  updateTeleConsult(id: ID!, input: UpdateTeleConsultInput!): TeleConsult!
  cancelTeleConsult(id: ID!): TeleConsult!
  # Referrals
  createReferral(input: CreateReferralInput!): Referral!
  setReferralStatus(id: ID!, status: String!): Referral!
  deleteReferral(id: ID!): Boolean!
  """Set or clear a referral's commission terms. Not yet settled."""
  setReferralCommission(id: ID!, input: SetReferralCommissionInput!): Referral!
  """Freeze the commission amount, mark the referral settled, and (when Phase 3 accounting is live) post the payable to the GL."""
  settleReferral(id: ID!): Referral!
  # Patient portal login (admin creates the patient's account)
  createPatientLogin(patientId: ID!, email: String!, password: String): Patient!
}

# ── Ask PeepalAI (natural-language questions over permitted data) ──

type PeepalAIAnswer {
  answer: String!
  sql: String!
  columns: [String!]!
  rows: [[String!]!]!
  denied: Boolean!
  message: String!
}

extend type Query {
  askPeepalAI(question: String!): PeepalAIAnswer!
}

# ─────────────────────────────────────────────────────────────────────────────
# Procurement & pharmacy batches (Phase 2)
# ─────────────────────────────────────────────────────────────────────────────

"""A supplier of goods or services."""
type Vendor {
  id: ID!
  name: String!
  code: String
  gstin: String
  contactName: String
  phone: String
  email: String
  address: String
  paymentTerms: String
  active: Boolean!
  createdAt: String
}

"""A purchase order sent to a vendor."""
type PurchaseOrder {
  id: ID!
  poNumber: String!
  vendorId: String!
  vendor: Vendor
  orderDate: String
  expectedDate: String
  status: String!
  subtotal: Float!
  taxTotal: Float!
  total: Float!
  notes: String
  items: [PurchaseOrderItem!]!
  createdAt: String
}

"""One ordered line on a purchase order."""
type PurchaseOrderItem {
  id: ID!
  itemId: String
  itemName: String!
  qty: Float!
  receivedQty: Float!
  unitCost: Float!
  taxPct: Float!
  lineTotal: Float!
}

"""A supplier bill, optionally against a purchase order."""
type PurchaseInvoice {
  id: ID!
  invoiceNumber: String!
  vendorId: String!
  vendor: Vendor
  purchaseOrderId: String
  invoiceDate: String
  dueDate: String
  subtotal: Float!
  taxTotal: Float!
  total: Float!
  paidAmount: Float!
  status: String!
  createdAt: String
}

"""A received lot of a drug with its own expiry and remaining quantity (FEFO)."""
type DrugBatch {
  id: ID!
  drugId: String!
  drugName: String
  batchNo: String!
  expiryDate: String
  qty: Float!
  unitCost: Float!
  receivedFromPoId: String
  createdAt: String
}

input CreateVendorInput {
  name: String!
  code: String
  gstin: String
  contactName: String
  phone: String
  email: String
  address: String
  paymentTerms: String
  active: Boolean
}

input UpdateVendorInput {
  name: String
  code: String
  gstin: String
  contactName: String
  phone: String
  email: String
  address: String
  paymentTerms: String
  active: Boolean
}

input PurchaseOrderItemInput {
  itemId: String
  itemName: String!
  qty: Float!
  unitCost: Float!
  taxPct: Float
}

input CreatePurchaseOrderInput {
  vendorId: String!
  orderDate: String
  expectedDate: String
  notes: String
  items: [PurchaseOrderItemInput!]!
}

input UpdatePurchaseOrderInput {
  vendorId: String
  orderDate: String
  expectedDate: String
  notes: String
  items: [PurchaseOrderItemInput!]
}

input ReceiveLineInput {
  """The PurchaseOrderItem id being received against."""
  lineId: String!
  receivedQty: Float!
  """Batch number, required when the line replenishes a pharmacy drug."""
  batchNo: String
  """Expiry date YYYY-MM-DD for the received drug batch."""
  expiryDate: String
}

input ReceivePurchaseOrderInput {
  lines: [ReceiveLineInput!]!
}

input CreatePurchaseInvoiceInput {
  invoiceNumber: String!
  vendorId: String!
  purchaseOrderId: String
  invoiceDate: String
  dueDate: String
  subtotal: Float
  taxTotal: Float
  total: Float
}

input RecordPurchasePaymentInput {
  invoiceId: String!
  amount: Float!
}

# ─────────────────────────────────────────────────────────────────────────────
# ── Finance ── (Phase 3: chart of accounts + double-entry general ledger)
# ─────────────────────────────────────────────────────────────────────────────

"""One node of the chart of accounts (a tree). System accounts are seeded and immutable."""
type Account {
  id: ID!
  code: String!
  name: String!
  type: String!
  parentId: String
  isSystem: Boolean!
  systemKey: String
  active: Boolean!
  createdAt: String
}

"""One debit or credit line of a journal entry."""
type LedgerEntry {
  id: ID!
  batchId: String!
  accountId: String!
  accountCode: String
  accountName: String
  debit: Float!
  credit: Float!
  memo: String
}

"""A journal entry: a balanced set of lines mirroring one source document."""
type LedgerBatch {
  id: ID!
  date: String!
  memo: String
  sourceType: String
  sourceId: String
  posted: Boolean!
  reversed: Boolean!
  lines: [LedgerEntry!]!
  createdAt: String
}

type AccountLedgerRow {
  batchId: String!
  date: String!
  memo: String
  debit: Float!
  credit: Float!
  balance: Float!
}

"""Running-balance view of a single account over a date range."""
type AccountLedger {
  account: Account!
  openingBalance: Float!
  closingBalance: Float!
  rows: [AccountLedgerRow!]!
}

type TrialBalanceRow {
  accountId: String!
  code: String!
  name: String!
  type: String!
  debit: Float!
  credit: Float!
}

type StatementLine {
  code: String!
  name: String!
  amount: Float!
}

type StatementSection {
  title: String!
  lines: [StatementLine!]!
  total: Float!
}

"""A computed P&L or balance sheet: titled sections with a headline total."""
type FinancialStatement {
  title: String!
  from: String
  to: String
  asOf: String
  sections: [StatementSection!]!
  total: Float!
  balanced: Boolean!
}

"""One open receivable/payable row for the aging report, pulled from source docs."""
type AgingRow {
  partyId: String!
  partyName: String!
  reference: String!
  date: String
  dueDate: String
  amount: Float!
  daysOverdue: Int!
  bucket: String!
}

input LedgerLineInput {
  accountId: String!
  debit: Float
  credit: Float
  memo: String
}

input CreateAccountInput {
  code: String!
  name: String!
  type: String!
  parentId: String
}

input UpdateAccountInput {
  code: String
  name: String
  parentId: String
  active: Boolean
}

input CreateManualJournalInput {
  date: String!
  memo: String
  lines: [LedgerLineInput!]!
}

extend type Query {
  accounts(type: String, activeOnly: Boolean): [Account!]!
  account(id: ID!): Account
  ledgerBatches(from: String, to: String, sourceType: String): [LedgerBatch!]!
  accountLedger(accountId: ID!, from: String, to: String): AccountLedger!
  trialBalance(asOf: String): [TrialBalanceRow!]!
  profitAndLoss(from: String!, to: String!): FinancialStatement!
  balanceSheet(asOf: String!): FinancialStatement!
  accountsReceivableAging(asOf: String): [AgingRow!]!
  accountsPayableAging(asOf: String): [AgingRow!]!
}

extend type Mutation {
  createAccount(input: CreateAccountInput!): Account!
  updateAccount(id: ID!, input: UpdateAccountInput!): Account!
  deleteAccount(id: ID!): Boolean!
  createManualJournal(input: CreateManualJournalInput!): LedgerBatch!
}

# ═══════════════════════════════════════════════════════════════════════════
# Phase 4 — General staff duty roster (cross-industry HR)
# A dated-shift roster for any employee role, generalised from
# ClinicianSchedule (which stays healthcare-only, feeding appointment booking).
# ═══════════════════════════════════════════════════════════════════════════

"""One dated shift assignment for an employee."""
type DutyRoster {
  id: ID!
  """Employee (Employee) UUID."""
  employeeId: String!
  """Employee display name."""
  employeeName: String!
  """Shift date (YYYY-MM-DD)."""
  date: String!
  """Shift label: Morning | Evening | Night | custom."""
  shiftName: String
  """Shift start (HH:MM, 24h)."""
  startTime: String!
  """Shift end (HH:MM, 24h)."""
  endTime: String!
  """Ward / desk / department, free text."""
  location: String
  notes: String
  createdAt: String
}

input CreateDutyRosterInput {
  employeeId: String!
  """Shift date (YYYY-MM-DD)."""
  date: String!
  shiftName: String
  startTime: String!
  endTime: String!
  location: String
  notes: String
}

input UpdateDutyRosterInput {
  date: String
  shiftName: String
  startTime: String
  endTime: String
  location: String
  notes: String
}

"""One shift row within a bulkSetDutyRoster call."""
input DutyRosterShiftInput {
  employeeId: String!
  date: String!
  shiftName: String
  startTime: String!
  endTime: String!
  location: String
  notes: String
}

input BulkSetDutyRosterInput {
  shifts: [DutyRosterShiftInput!]!
}

"""Per-row outcome of a bulkSetDutyRoster call, so a roster grid submit can
report exactly which shifts landed and which collided."""
type BulkDutyRosterResult {
  created: Int!
  failed: Int!
  errors: [String!]!
}

extend type Query {
  """List duty-roster shifts. All filters optional; non-admins are always
  scoped to their own shifts regardless of employeeId."""
  dutyRoster(from: String, to: String, employeeId: String, departmentId: String): [DutyRoster!]!
}

extend type Mutation {
  createDutyRoster(input: CreateDutyRosterInput!): DutyRoster!
  updateDutyRoster(id: ID!, input: UpdateDutyRosterInput!): DutyRoster!
  deleteDutyRoster(id: ID!): Boolean!
  """Write many shifts in one transaction (roster grid submit). Rows that
  collide with an existing shift are skipped and reported, not fatal."""
  bulkSetDutyRoster(input: BulkSetDutyRosterInput!): BulkDutyRosterResult!
}

# ── Exam Cell (Phase 5) ─────────────────────────────────────────────
# Question bank → rule-based paper generation → hall tickets with QR.

"""A reusable question in the bank, scoped to one curriculum subject."""
type QuestionBankItem {
  """Unique identifier."""
  id: ID!
  """Curriculum subject (course + semester + subject) this question belongs to."""
  curriculumSubjectId: ID!
  """Subject UUID, denormalized from the curriculum row."""
  subjectId: String
  """The subject itself, when loaded."""
  subject: Subject
  """Syllabus unit / topic label this question covers."""
  unit: String
  """The question as it should be printed."""
  questionText: String!
  """Shape: mcq | short | long | numeric."""
  questionType: String!
  """Difficulty bucket: easy | medium | hard."""
  difficulty: String!
  """Marks this question carries."""
  marks: Float!
  """Answer choices. Populated for mcq, empty otherwise."""
  options: [String!]!
  """Model answer or the correct option."""
  answer: String
  """Course-outcome tag (CO1, CO2, …) for outcome mapping."""
  courseOutcome: String
  """Whether the question is in the active pool for generation."""
  active: Boolean!
  """Authoring employee UUID. Blank once that employee is removed."""
  createdById: String
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

"""A generated question paper. Items are frozen at generation time."""
type QuestionPaper {
  """Unique identifier."""
  id: ID!
  """Paper title, e.g. "Mid Sem - Data Structures"."""
  title: String!
  """Linked exam type (assessment definition), when set."""
  examTypeId: String
  """The exam type itself, when loaded."""
  examType: ExamType
  """Curriculum subject the paper was generated for."""
  curriculumSubjectId: ID!
  """Subject UUID."""
  subjectId: String
  """The subject itself, when loaded."""
  subject: Subject
  """Total marks on the paper."""
  totalMarks: Float!
  """Exam duration in minutes."""
  durationMinutes: Int
  """Instructions printed above the questions."""
  instructions: String
  """The JSON rule blueprint used, kept for audit and regeneration."""
  generationRule: String
  """draft | finalized. Drafts print with a DRAFT watermark."""
  status: String!
  """The questions on the paper, in print order."""
  items: [QuestionPaperItem!]!
  """Authoring user UUID."""
  createdById: String
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

"""One frozen question on a generated paper."""
type QuestionPaperItem {
  """Unique identifier."""
  id: ID!
  """Bank question this was copied from, for set-frequency analytics."""
  sourceQuestionId: String
  """Print order, 1-based."""
  seqNo: Int!
  """The question text as printed."""
  questionText: String!
  """Shape: mcq | short | long | numeric."""
  questionType: String!
  """Marks carried."""
  marks: Float!
  """Answer choices for mcq items."""
  options: [String!]!
  """Section grouping (A/B/C) derived from the question shape."""
  section: String
}

"""A student's admit card for one exam schedule."""
type HallTicket {
  """Unique identifier."""
  id: ID!
  """Exam schedule this ticket admits the student to."""
  examScheduleId: ID!
  """The exam schedule itself, when loaded."""
  examSchedule: ExamSchedule
  """Student UUID."""
  studentId: ID!
  """The student, when loaded."""
  student: Student
  """Human-readable ticket number, HT-000123, unique per tenant."""
  ticketNumber: String!
  """Assigned seat, when seating has been allotted."""
  seatNumber: String
  """Exam centre / venue."""
  examCenter: String
  """Whether the student cleared the eligibility check."""
  eligible: Boolean!
  """Why the ticket is on hold, when it is."""
  holdReason: String
  """Issue date (YYYY-MM-DD)."""
  issuedOn: String
  """issued | held | revoked."""
  status: String!
  """Signed verify URL encoded into the printed QR code."""
  qrPayload: String!
  """Creation timestamp (RFC3339)."""
  createdAt: String
}

"""Outcome of a bulk hall-ticket issue run."""
type HallTicketIssueResult {
  """Tickets issued to eligible students in this run."""
  issued: Int!
  """Students stored as held because they failed the eligibility check."""
  held: Int!
  """Students that already had a ticket for this schedule."""
  skipped: Int!
  """Every ticket for the schedule after the run."""
  tickets: [HallTicket!]!
}

input CreateQuestionBankItemInput {
  """Curriculum subject the question belongs to."""
  curriculumSubjectId: ID!
  """Syllabus unit / topic label."""
  unit: String
  """The question text. Required."""
  questionText: String!
  """Shape: mcq | short | long | numeric. Defaults to long."""
  questionType: String
  """Difficulty: easy | medium | hard. Defaults to medium."""
  difficulty: String
  """Marks the question carries. Defaults to 1."""
  marks: Float
  """Answer choices, for mcq questions."""
  options: [String!]
  """Model answer or correct option."""
  answer: String
  """Course-outcome tag."""
  courseOutcome: String
  """Whether the question joins the active pool. Defaults to true."""
  active: Boolean
}

input UpdateQuestionBankItemInput {
  unit: String
  questionText: String
  questionType: String
  difficulty: String
  marks: Float
  options: [String!]
  answer: String
  courseOutcome: String
  active: Boolean
}

"""One difficulty bucket's marks target in a generation rule."""
input DifficultyMarksInput {
  """easy | medium | hard."""
  difficulty: String!
  """Marks to fill from this bucket."""
  marks: Float!
}

"""A desired question count for one shape."""
input TypeCountInput {
  """mcq | short | long | numeric."""
  questionType: String!
  """How many questions of this shape to include."""
  count: Int!
}

input GenerateQuestionPaperInput {
  """Paper title."""
  title: String!
  """Exam type (assessment definition) to link."""
  examTypeId: String
  """Curriculum subject to draw questions from."""
  curriculumSubjectId: ID!
  """Target total marks."""
  totalMarks: Float!
  """Exam duration in minutes."""
  durationMinutes: Int
  """Instructions to print above the questions."""
  instructions: String
  """Marks target per difficulty bucket. Omit to let the generator spread freely."""
  byDifficulty: [DifficultyMarksInput!]
  """Restrict to these syllabus units. Omit for the whole syllabus."""
  units: [String!]
  """Desired question count per shape."""
  typeMix: [TypeCountInput!]
  """Seed for reproducible generation. Omit for a fresh random set."""
  seed: Int
}

input IssueHallTicketsInput {
  """Exam schedule to issue tickets for."""
  examScheduleId: ID!
  """Restrict to one course. Omit to cover every course in the schedule's semester."""
  courseId: String
  """Override the schedule's semester number."""
  semesterNumber: Int
  """Exam centre printed on every ticket."""
  examCenter: String
  """Seat-number prefix; seats are numbered sequentially from 1."""
  seatPrefix: String
  """Hold students who have outstanding fee dues."""
  checkFeeDues: Boolean
  """Hold students below this attendance percentage. Omit to skip the check."""
  minAttendancePercent: Float
}

# ═══════════════════════════════════════════════════════════════════════════
# Phase 6 — Student Life & Campus Ops
# Three education-tagged campus modules: student coursework (assignments +
# submissions), the mess/canteen (menu, meal attendance, provisioning spend
# linked to Phase 2 procurement), and live transport (vehicle GPS pings +
# driver attendance).
# ═══════════════════════════════════════════════════════════════════════════

# ── Student Life (assignments) ──────────────────────────────────────

"""Coursework a teacher sets for one course-semester-section-subject.
Distinct from the employee L&D LearningAssignment."""
type StudentAssignment {
  id: ID!
  title: String!
  description: String
  """Course (Course) UUID this is set for."""
  courseId: String
  courseName: String
  semester: Int
  section: String
  """Subject (Subject) UUID."""
  subjectId: String
  subjectName: String
  """Teacher (Employee) UUID who set it."""
  teacherId: String!
  teacherName: String!
  """Marks the assignment is out of; 0 means ungraded."""
  maxMarks: Float!
  """Due date (YYYY-MM-DD)."""
  dueDate: String
  """Optional teacher handout URL, uploaded via the existing upload route."""
  attachmentUrl: String
  """draft | published | closed."""
  status: String!
  """How many students have submitted so far."""
  submissionCount: Int!
  """How many of those submissions are graded."""
  gradedCount: Int!
  createdAt: String
}

input CreateStudentAssignmentInput {
  title: String!
  description: String
  courseId: String
  semester: Int
  section: String
  subjectId: String
  maxMarks: Float
  """Due date (YYYY-MM-DD)."""
  dueDate: String
  attachmentUrl: String
}

input UpdateStudentAssignmentInput {
  title: String
  description: String
  courseId: String
  semester: Int
  section: String
  subjectId: String
  maxMarks: Float
  dueDate: String
  attachmentUrl: String
}

"""One student's answer to one assignment. At most one row per
(student, assignment) — resubmitting updates the same row."""
type AssignmentSubmission {
  id: ID!
  assignmentId: String!
  assignmentTitle: String
  """Marks the parent assignment is out of, so a grading form needs one fetch."""
  maxMarks: Float!
  studentId: String!
  studentName: String!
  rollNumber: String
  """Date submitted (YYYY-MM-DD)."""
  submittedAt: String
  """Typed answer."""
  text: String
  """Uploaded file URL."""
  attachmentUrl: String
  """submitted | graded | returned."""
  status: String!
  marksAwarded: Float
  feedback: String
  gradedByName: String
  createdAt: String
}

"""A published assignment as a student sees it, with their own submission
attached (null when they have not submitted yet)."""
type MyAssignment {
  assignment: StudentAssignment!
  submission: AssignmentSubmission
  """False once the assignment is closed, so the UI can hide the submit form."""
  canSubmit: Boolean!
  """True when submitted after the due date."""
  late: Boolean!
}

input SubmitAssignmentInput {
  text: String
  attachmentUrl: String
}

extend type Query {
  """Assignments set by teachers. Teachers see their own; admins see all."""
  studentAssignments(courseId: String, subjectId: String, semester: Int, section: String, status: String): [StudentAssignment!]!
  """One assignment by id (teacher/admin)."""
  studentAssignment(id: ID!): StudentAssignment
  """Every submission against one assignment (teacher/admin grading view)."""
  assignmentSubmissions(assignmentId: ID!): [AssignmentSubmission!]!
  """Self-service: published assignments for the caller's own
  course/semester/section, each with their own submission."""
  myAssignments(status: String): [MyAssignment!]!
}

extend type Mutation {
  createStudentAssignment(input: CreateStudentAssignmentInput!): StudentAssignment!
  updateStudentAssignment(id: ID!, input: UpdateStudentAssignmentInput!): StudentAssignment!
  """Make a draft visible to students."""
  publishStudentAssignment(id: ID!): StudentAssignment!
  """Stop accepting submissions."""
  closeStudentAssignment(id: ID!): StudentAssignment!
  deleteStudentAssignment(id: ID!): Boolean!
  """Award marks + feedback on a submission (teacher/admin)."""
  gradeAssignmentSubmission(id: ID!, marksAwarded: Float!, feedback: String): AssignmentSubmission!
  """Self-service: create or replace the caller's own submission."""
  submitAssignment(assignmentId: ID!, input: SubmitAssignmentInput!): AssignmentSubmission!
}

# ── Mess / canteen ──────────────────────────────────────────────────

"""One cell of the weekly menu grid: what is served for a given day + meal."""
type MessMenu {
  id: ID!
  """0 = Sunday … 6 = Saturday."""
  dayOfWeek: Int!
  """breakfast | lunch | snacks | dinner."""
  meal: String!
  """Newline-separated item list."""
  items: String
  """Optional hostel block; empty means campus-wide."""
  hostelBlockId: String
  hostelBlockName: String
  createdAt: String
}

input MessMenuInput {
  dayOfWeek: Int!
  meal: String!
  items: String
  hostelBlockId: String
}

"""One student's meal row for a date + meal."""
type MessAttendanceRow {
  id: ID
  studentId: String!
  studentName: String!
  rollNumber: String
  date: String!
  meal: String!
  present: Boolean!
}

"""Outcome of a roster-style mess attendance submit."""
type MessAttendanceResult {
  marked: Int!
  cleared: Int!
}

"""One mess provisioning cost, optionally traced to a Phase 2 vendor / PO."""
type MessExpense {
  id: ID!
  """YYYY-MM-DD."""
  date: String!
  """groceries | gas | staff | other."""
  category: String!
  description: String
  amount: Float!
  vendorId: String
  vendorName: String
  purchaseOrderId: String
  poNumber: String
  createdAt: String
}

input MessExpenseInput {
  date: String!
  category: String
  description: String
  amount: Float!
  vendorId: String
  purchaseOrderId: String
}

"""Spend total for one expense category within the queried window."""
type MessCategoryTotal {
  category: String!
  total: Float!
}

"""Aggregate spend for the queried window, for the expense page header."""
type MessExpenseSummary {
  total: Float!
  byCategory: [MessCategoryTotal!]!
}

extend type Query {
  """Weekly menu, optionally for one hostel block."""
  messMenu(hostelBlockId: String): [MessMenu!]!
  """Self-service: this week's menu for the caller's own hostel block
  (falls back to the campus-wide menu)."""
  myMessMenu: [MessMenu!]!
  """Meal roster for a date + meal: every eligible student with their mark."""
  messAttendance(date: String!, meal: String!, hostelBlockId: String): [MessAttendanceRow!]!
  """Provisioning expenses in a date range."""
  messExpenses(from: String, to: String, category: String): [MessExpense!]!
  """Totals for the same window as messExpenses."""
  messExpenseSummary(from: String, to: String): MessExpenseSummary!
}

extend type Mutation {
  """Create or replace the menu cell for a (day, meal, block)."""
  setMessMenu(input: MessMenuInput!): MessMenu!
  deleteMessMenu(id: ID!): Boolean!
  """Roster submit: the listed students are marked present for that meal and
  every other student's existing mark for it is cleared."""
  markMessAttendance(date: String!, meal: String!, studentIds: [String!]!): MessAttendanceResult!
  createMessExpense(input: MessExpenseInput!): MessExpense!
  updateMessExpense(id: ID!, input: MessExpenseInput!): MessExpense!
  deleteMessExpense(id: ID!): Boolean!
}

# ── Transport Live (GPS + driver attendance) ────────────────────────

"""A vehicle with its last known position, for the live map."""
type LiveVehicle {
  id: ID!
  vehicleNumber: String!
  vehicleType: String!
  capacity: Int!
  status: String!
  routeId: String
  routeName: String
  latitude: Float!
  longitude: Float!
  """RFC3339; null when the vehicle has never reported a position."""
  lastPingAt: String
  driverEmployeeId: String
  """Driver's employee name, falling back to the legacy free-text driverName."""
  driverName: String
  driverPhone: String
}

"""A driver's day sheet: which vehicle they signed on to and when."""
type DriverAttendance {
  id: ID!
  employeeId: String!
  employeeName: String!
  vehicleId: String
  vehicleNumber: String
  """YYYY-MM-DD."""
  date: String!
  """HH:MM."""
  checkInAt: String
  checkOutAt: String
  """present | absent | leave."""
  status: String!
  createdAt: String
}

input DriverAttendanceInput {
  employeeId: String!
  vehicleId: String
  date: String!
  checkInAt: String
  checkOutAt: String
  status: String
}

extend type Query {
  """Every vehicle with its last known position (live map feed)."""
  liveVehicles: [LiveVehicle!]!
  """Driver day sheets. Pass date for one day, or from/to for a range."""
  driverAttendance(date: String, from: String, to: String, employeeId: String, vehicleId: String): [DriverAttendance!]!
}

extend type Mutation {
  """Record a vehicle's current position and stamp lastPingAt."""
  pingVehicleLocation(vehicleId: ID!, latitude: Float!, longitude: Float!): LiveVehicle!
  """Create or update a driver's day sheet (upsert on employee + date)."""
  markDriverAttendance(input: DriverAttendanceInput!): DriverAttendance!
  """Driver self check-in for today onto a vehicle."""
  driverCheckIn(vehicleId: ID!): DriverAttendance!
  """Driver self check-out for today."""
  driverCheckOut: DriverAttendance!
  deleteDriverAttendance(id: ID!): Boolean!
}

# ── My Schedule (a clinician's own calendar) ─────────────────────────────────
"""
A clinician's own calendar for a date range: the weekly consulting windows they
keep, plus every appointment booked into them. Scoped to the caller, so a doctor
sees this without needing access to the admin Schedules or Appointments pages.
"""
type MyClinicianCalendar {
  """Employee UUID of the calling clinician."""
  clinicianId: ID!
  """Clinician display name."""
  clinicianName: String!
  """Weekly consulting windows (all days, both active and inactive)."""
  windows: [ClinicianSchedule!]!
  """Appointments falling inside the requested range, earliest first."""
  appointments: [Appointment!]!
}

extend type Query {
  """
  The calling clinician's calendar between two YYYY-MM-DD dates (inclusive).
  Errors when the caller has no employee record.
  """
  myClinicianCalendar(from: String!, to: String!): MyClinicianCalendar!
}

"""
One switchable role context for a user.

A workspace is simply "this person, acting as one of their roles". Switching
re-mints the auth cookie with a different active role, so every permission check
in the app resolves against the workspace the user is currently in.
"""
type Workspace {
  """Base role id this workspace activates (admin/teacher/staff/student/patient)."""
  role: String!
  """Tenant's label for that role (e.g. "Clinician" in a hospital)."""
  label: String!
  """True for the workspace backed by the user's primary role. Never revocable."""
  isPrimary: Boolean!
  """Optional per-workspace custom-role permission overlay."""
  customRoleId: ID
}

"""One additional workspace grant, as edited on the admin forms."""
input WorkspaceRoleInput {
  """Base role id to grant. super_admin may not be granted."""
  role: String!
  """Optional custom-role overlay to apply inside that workspace."""
  customRoleId: ID
}

extend type Query {
  """Workspaces the calling user may switch into, in display order."""
  myWorkspaces: [Workspace!]!
  """
  Workspaces held by any user in the tenant (admin only). Includes their
  primary role as the first, non-revocable entry.
  """
  userWorkspaces(userId: ID!): [Workspace!]!
}

extend type Mutation {
  """
  Replace a user's additional workspace grants (admin only). The user's primary
  role is implicit and is ignored if passed. Returns the resulting full list.
  """
  setUserWorkspaceRoles(userId: ID!, roles: [WorkspaceRoleInput!]!): [Workspace!]!
}

extend type Query {
  """The tenant's saved OPD slip design as a JSON string, or null when the admin has not customised it yet."""
  opdSlipConfig: String
  """One appointment by id, for the printable OPD slip. Same visibility scoping as the appointments list."""
  appointment(id: ID!): Appointment
}

extend type Mutation {
  """Save the tenant's OPD slip design (JSON string). Admin only."""
  updateOpdSlipConfig(content: String!): String!
}

# ── Device tokens (mobile push) ───────────────────────────────────────────────
# Registering a push token is self-service: it says "this install, signed in as
# me, can receive notifications". It is therefore deliberately absent from the
# opAccess matrix, like the other my*/self-service operations.

"""One app install that can receive push notifications."""
type DeviceToken {
  """Unique identifier."""
  id: ID!
  """Device platform: ios | android | web."""
  platform: String!
  """The app's own install id, for showing a recognisable device list."""
  deviceId: String
  """Human label for the device, e.g. "Ward 3 iPad"."""
  deviceName: String
  """App version that last registered this token."""
  appVersion: String
  """ISO 8601 timestamp of the last registration from this install."""
  lastSeenAt: String!
  """ISO 8601 timestamp when the install first registered."""
  createdAt: String!
}

input RegisterDeviceTokenInput {
  """The Expo push token issued to this install."""
  token: String!
  """Device platform: ios | android | web."""
  platform: String!
  """The app's own install id. Optional; used only for the device list."""
  deviceId: String
  """Human label for the device. Optional."""
  deviceName: String
  """App version. Optional; useful when diagnosing delivery problems."""
  appVersion: String
}

extend type Query {
  """
  The calling user's registered devices, newest first. Backs the "signed-in
  devices" screen so a user can see and drop an install they no longer have.
  """
  myDeviceTokens: [DeviceToken!]!
}

extend type Mutation {
  """
  Register (or re-point) this install's push token for the calling user.
  Registering a token already held by someone else reassigns it, so a shared
  device never delivers one user's notifications to the next.
  """
  registerDeviceToken(input: RegisterDeviceTokenInput!): DeviceToken!
  """
  Stop delivering to one push token. Called on sign-out so a signed-out device
  goes quiet immediately rather than waiting for the token to expire.
  """
  revokeDeviceToken(token: String!): Boolean!
}

# ── Sessions (signed-in devices) ──────────────────────────────────────────────
# A session is one login: an access token plus the refresh-token family that
# renews it. These operations are what make a session revocable in practice —
# without them the only way to end someone else's session was to wait out its
# absolute deadline.
#
# The my* operations are self-service and therefore absent from the opAccess
# matrix, like myDeviceTokens. The admin-facing ones are gated on the `admins`
# module, since signing a user out is an act of user administration.

"""One signed-in session, summarised from its refresh-token rotation chain."""
type UserSession {
  """The session family's id. Stable across refreshes; used to revoke it."""
  id: ID!
  """True for the session making this request, so the UI can say "this device"."""
  current: Boolean!
  """The workspace this session is currently in, e.g. admin | teacher."""
  activeRole: String!
  """ISO 8601 timestamp of the login that began this session."""
  createdAt: String!
  """ISO 8601 timestamp of the session's most recent refresh."""
  lastUsedAt: String!
  """ISO 8601 timestamp of the session's absolute deadline."""
  expiresAt: String!
  """Raw User-Agent recorded at the last refresh. May be empty."""
  userAgent: String
  """A readable device/browser guess derived from the User-Agent."""
  deviceLabel: String!
  """IP recorded at the last refresh. May be empty."""
  ip: String
}

extend type Query {
  """
  The calling user's live sessions, most recently used first. Backs the
  "where you're signed in" screen.
  """
  mySessions: [UserSession!]!
  """
  One user's live sessions. Admin-only, and scoped to the caller's tenant, so
  an admin can see what they are about to sign out.
  """
  userSessions(userId: ID!): [UserSession!]!
}

extend type Mutation {
  """
  End one of the caller's own sessions. Naming a session that is not theirs is
  refused rather than silently ignored, since the id is theirs to know.
  """
  revokeMySession(sessionId: ID!): Boolean!
  """
  End every session of the caller's except the one making the request. Returns
  how many were ended, so the UI can report "signed out of 3 other devices".
  """
  revokeMyOtherSessions: Int!
  """
  End every session belonging to a user in the caller's tenant. Admin-only.
  Returns how many were ended.
  """
  revokeUserSessions(userId: ID!): Int!
}

# ── On-prem system updates (tenant admin) ─────────────────────────────────────
# Status/snooze/apply against peepal-agent's loopback control API. Presence
# counts come from GET /api/v1/presence WebSocket connections in this tenant.

"""Installed vs available release versions and tenant snooze / presence state."""
type SystemUpdateStatus {
  installedBackend: String!
  installedFrontend: String!
  availableBackend: String!
  availableFrontend: String!
  updateAvailable: Boolean!
  snoozed: Boolean!
  snoozedUntil: String
  activeUsersInTenant: Int!
  agentReachable: Boolean!
}

extend type Query {
  """Tenant-admin view of whether a newer release is available for this install."""
  systemUpdateStatus: SystemUpdateStatus!
}

extend type Mutation {
  """Suppress the update popup for this tenant for one hour (does not delay auto-apply)."""
  snoozeSystemUpdate: SystemUpdateStatus!
  """Ask peepal-agent to apply the available update now."""
  applySystemUpdate: Boolean!
}
