  state: String
  """PIN code."""
  pincode: String
  """Nationality."""
  nationality: String
  """Emergency contact name."""
  emergencyName: String
  """Emergency contact phone."""
  emergencyPhone: String
  """Father's name."""
  fatherName: String
  """Father's phone."""
  fatherPhone: String
  """Mother's name."""
  motherName: String
  """Mother's phone."""
  motherPhone: String
  """Admission status."""
  admissionStatus: String
  """Batch/cohort label."""
  batch: String
}

"""Input for updating a subject (all fields optional)."""
input UpdateSubjectInput {
  """Updated name."""
  name: String
  """Updated code."""
  code: String
  """Updated department UUID."""
  departmentId: String
  """Updated credits."""
  credits: Int
  """Updated teaching hours."""
