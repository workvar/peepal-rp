  plan: String!
  """Total collected under this plan."""
  amount: Float!
  """Number of payments under this plan."""
  count: Int!
}

"""Fee collection report."""
type FeeReportResult {
  """Total amount collected."""
  totalCollected: Float!
  """Total payment transactions."""
  paymentCount: Int!
  """Monthly collection trend."""
  monthlyTrend: [FeeMonthRow!]!
  """Breakdown by payment mode."""
  byPaymentMode: [FeeModeRow!]!
  """Breakdown by fee plan."""
  byPlan: [FeePlanReportRow!]!
}

"""Result of calendar auto-generation."""
type GenerateCalendarResult {
  year: Int!
  created: Int!
}

