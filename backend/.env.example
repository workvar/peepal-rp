# Copy to .env and fill in real values. Never commit .env.
PORT=3001
APP_ENV=development

# Generate with: openssl rand -base64 48  (min 32 chars, required)
JWT_SECRET=

# PostgreSQL connection string
DB_PATH=postgres://USER:PASSWORD@localhost:5432/DBNAME?sslmode=disable

# Seeded on first run. Required; the default placeholder is rejected.
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=

# Comma-separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:3000

# Auth cookie scope. Leave EMPTY for local dev so the cookie is host-only on
# localhost (a Domain like .workvar.com is rejected by the browser on localhost,
# which silently breaks login/logout). Set to the shared parent domain
# (e.g. .workvar.com) only in production.
COOKIE_DOMAIN=

# Raspberry Pi / LAN mDNS. When true, login works at http://raspberrypi.local:
# Secure cookies are off (the hostname is HTTP), COOKIE_DOMAIN stays empty
# (.local is a public suffix so a Domain attribute is rejected), CORS allows
# raspberrypi.local / other *.local hosts / private LAN IPs, and APP_BASE_URL
# is rewritten from localhost to http://raspberrypi.local. Restart the backend
# (or peepal-agent) after changing this.
RPI_LOCAL_ENABLE=false

# ── Session lifetimes ────────────────────────────────────────────────────────
# Access token (the JWT every request carries). Kept short: it cannot be
# revoked once minted, so this window is the blast radius of a leak. Browser
# sessions renew it silently via POST /auth/refresh.
ACCESS_TOKEN_TTL=15m
# Refresh token: how long a session can survive without re-entering a password.
# Absolute — rotating a token does not extend it.
REFRESH_TOKEN_TTL=720h
# How long a just-rotated refresh token is still forgiven, so parallel tabs
# racing to refresh are not mistaken for a stolen token.
REFRESH_REUSE_GRACE=30s

# Installer-managed on on-prem installs (optional for local dev)
PEEPAL_AGENT_URL=http://127.0.0.1:9080
PEEPAL_AGENT_TOKEN=
